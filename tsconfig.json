{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "typeRoots": ["./typings"]
  },
  "include": ["src/**/*.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "miniprogram"]
}
