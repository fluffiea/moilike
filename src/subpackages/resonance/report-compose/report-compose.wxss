.counter {
  display: block;
  margin-bottom: 24rpx;
  text-align: right;
}

.when {
  display: flex;
  flex-direction: row;
}

.when__item {
  flex: 1;
  margin-right: 20rpx;
}

.when__item--last {
  margin-right: 0;
}

.when__field {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.when__text {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.tag-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 8rpx 0 16rpx;
}

.tag-input__field {
  flex: 1;
}

.tag-input__add {
  padding: 0 8rpx 0 24rpx;
  font-size: 26rpx;
  line-height: 88rpx;
  color: var(--mo-brand-slate);
}

.tag-input__add--off {
  color: var(--mo-text-muted);
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  background: rgba(28, 28, 30, 0.4);
}

.dialog {
  width: 100%;
  padding: 48rpx 40rpx 36rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.dialog__title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.dialog__text {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--mo-text-secondary);
}

.dialog__ok {
  margin-top: 36rpx;
}

.dialog__cancel {
  margin-top: 16rpx;
}
