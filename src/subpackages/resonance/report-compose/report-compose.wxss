.counter {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
  color: var(--mo-text-muted);
}

/* 记录时间：卡片里一行放下，左边说明右边两个短输入 */
.when {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.when__label {
  margin-right: 24rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.when__item {
  flex: 1;
  margin-right: 16rpx;
}

.when__item--last {
  flex-grow: 0;
  flex-shrink: 0;
  width: 168rpx;
  margin-right: 0;
}

.when__field {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
}

.when__item--last .when__field {
  justify-content: center;
}

.when__text {
  font-size: 26rpx;
  line-height: 80rpx;
  color: var(--mo-text-primary);
}

/* 标签标题行：标题在左，「可选」在右 */
.tag-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag-head__title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.tag-head__optional {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.tag-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag-input__field {
  flex: 1;
}

.tag-input__add {
  padding: 0 8rpx 0 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 88rpx;
  color: var(--mo-text-primary);
}

.tag-input__add--off {
  font-weight: 400;
  color: var(--mo-text-muted);
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  background: var(--mo-fill-overlay);
}

.dialog {
  width: 100%;
  padding: 48rpx 40rpx 36rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.dialog__title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.dialog__text {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}

.dialog__ok {
  margin-top: 36rpx;
}

.dialog__cancel {
  margin-top: 16rpx;
}
