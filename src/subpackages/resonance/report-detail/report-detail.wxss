.stickers {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.stickers--busy {
  pointer-events: none;
}

.sticker {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc((100% - 72rpx) / 4);
  margin: 24rpx 24rpx 0 0;
}

.sticker:nth-child(4n) {
  margin-right: 0;
}

/* 不铺灰底、不用石青圈：灰底吃掉浅色贴纸，石青又和「好的」同色 */
.sticker__art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--mo-radius-inner);
  border: 2rpx solid transparent;
}

.sticker--on .sticker__art {
  border-color: var(--mo-text-secondary);
}

.sticker--busy {
  opacity: 0.55;
}

.sticker__img {
  width: 104rpx;
  height: 104rpx;
}

.sticker__label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.sticker--on .sticker__label {
  font-weight: 600;
  color: var(--mo-text-primary);
}
