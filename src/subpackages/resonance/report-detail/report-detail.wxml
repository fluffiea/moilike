<view class="mo-page">
  <app-nav title="报备" show-back />
  <scroll-view class="mo-scroll" scroll-y>
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading'}}" status="loading" rows="{{1}}" />
      <state-view wx:elif="{{status === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRetry" />

      <block wx:else>
        <report-card post="{{post}}" detail bind:more="onMore" />

        <view wx:if="{{post.canRespond}}" class="mo-card action">
          <text class="mo-section-title">回一颗心</text>
          <text class="mo-hint">点一个贴纸，对方就知道你看过了。</text>
          <sticker-grid stickers="{{stickers}}" current-id="{{post.partnerStickerId}}" busy="{{busy}}" bind:pick="onSticker" />
        </view>
      </block>
    </view>
  </scroll-view>
</view>
