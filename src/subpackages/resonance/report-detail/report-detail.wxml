<view class="mo-page">
  <app-nav title="报备" show-back />
  <scroll-view class="mo-scroll" scroll-y>
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading'}}" status="loading" rows="{{1}}" />
      <state-view wx:elif="{{status === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRetry" />

      <block wx:else>
        <report-card post="{{post}}" detail bind:more="onMore" />

        <view wx:if="{{post.canRespond}}" class="mo-card action">
          <text class="mo-section-title">回一颗心</text>
          <text class="mo-hint">点一下＝已阅＋轻回应</text>
          <view class="stickers {{busy ? 'stickers--busy' : ''}}">
            <view
              wx:for="{{stickers}}"
              wx:key="id"
              class="sticker {{post.partnerStickerId === item.id ? 'sticker--on' : ''}} {{busy === item.id ? 'sticker--busy' : ''}}"
              data-id="{{item.id}}"
              bind:tap="onSticker"
              aria-role="button"
            >
              <view class="sticker__art">
                <image class="sticker__img" src="{{item.src}}" mode="aspectFit" />
              </view>
              <text class="sticker__label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
