/** 写信 · moilike-ui · Skyline —— 一张纸的书写空间 */

.letter-compose-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
}

/* ── 类型：纸上方一行，放不下就换行（不用横向 scroll-view：Skyline 下高度不可靠） ── */

.letter-compose-types {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 40rpx 4rpx;
}

.letter-compose-type {
  flex-shrink: 0;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--mo-radius-chip);
  background-color: rgba(255, 255, 255, 0.72);
  border: var(--mo-border-card);
}

.letter-compose-type--on {
  background-color: rgba(102, 143, 128, 0.14);
  border-color: rgba(102, 143, 128, 0.38);
}

.letter-compose-type-text {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--mo-text-secondary);
}

.letter-compose-type--on .letter-compose-type-text {
  color: var(--mo-text-primary);
  font-weight: 600;
}

.letter-compose-custom {
  flex-shrink: 0;
  margin: 4rpx 32rpx 8rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l1-card);
  border: 1rpx solid rgba(102, 143, 128, 0.38);
}

.letter-compose-custom-input {
  box-sizing: border-box;
  width: 100%;
  height: 44rpx;
  padding: 0;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 44rpx;
  color: var(--mo-text-primary);
}

.letter-compose-custom-ph {
  font-size: 26rpx;
  color: var(--mo-text-muted);
}

/* ── 纸 ── */

.letter-compose-body {
  flex: 1;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
}

.letter-compose-paper {
  box-sizing: border-box;
  min-height: 100%;
  padding: 44rpx 48rpx 88rpx;
  background-color: var(--mo-l1-card);
}

.letter-compose-salutation {
  display: block;
  margin-bottom: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  color: var(--mo-text-primary);
}

.letter-compose-title {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0;
  margin-bottom: 20rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 76rpx;
  letter-spacing: -0.01em;
  color: var(--mo-text-primary);
}

.letter-compose-title-ph {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--mo-text-muted);
}

.letter-compose-content {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-height: 520rpx;
  padding: 0;
  font-size: 31rpx;
  line-height: 1.9;
  color: var(--mo-text-primary);
}

.letter-compose-content-ph {
  font-size: 31rpx;
  line-height: 1.9;
  color: var(--mo-text-muted);
}

/* ── 配图 ── */

.letter-compose-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 36rpx;
}

.letter-compose-cell {
  position: relative;
  box-sizing: border-box;
  width: calc((100% - 24rpx) / 3);
  height: 176rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background-color: var(--mo-l1-accent);
}

.letter-compose-cell:nth-child(3n) {
  margin-right: 0;
}

.letter-compose-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.letter-compose-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(28, 28, 30, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.letter-compose-remove-x {
  font-size: 26rpx;
  line-height: 1;
  color: var(--mo-text-inverse);
}

/* ── 附件入口 ── */

.letter-compose-attach {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: var(--mo-border-card);
}

.letter-compose-add {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: var(--mo-radius-btn);
  border: 1rpx dashed rgba(102, 143, 128, 0.4);
  background-color: rgba(102, 143, 128, 0.06);
}

.letter-compose-add-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--mo-brand-slate);
}

.letter-compose-attach-hint {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--mo-text-secondary);
}

/* ── 底栏：字数 + 寄出 ── */

.letter-compose-footer {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: var(--mo-border-card);
}

.letter-compose-count {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--mo-text-secondary);
}

.letter-compose-send {
  flex-shrink: 0;
  min-width: 200rpx;
  height: 88rpx;
  padding: 0 56rpx;
  box-sizing: border-box;
  border-radius: var(--mo-radius-btn);
  background: var(--mo-gradient-brand);
  border: 1rpx solid rgba(74, 102, 112, 0.35);
  box-shadow:
    inset 0 1rpx 0 0 rgba(255, 255, 255, 0.22),
    0 4px 12px rgba(0, 0, 0, 0.02),
    0 12px 28px rgba(74, 102, 112, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.letter-compose-send--disabled {
  opacity: 0.38;
  pointer-events: none;
}

.letter-compose-send-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mo-text-inverse);
  letter-spacing: 0.04em;
}
