.paper {
  padding: 48rpx 40rpx 56rpx;
  border-radius: var(--mo-radius-card);
  background: var(--mo-l1-paper);
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 0.35s ease, transform 0.35s ease;
}

.paper--open {
  opacity: 1;
  transform: translateY(0);
}

.paper__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 56rpx;
}

.paper__meta-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.paper__more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx -24rpx -16rpx 0;
}

.paper__more-icon {
  width: 36rpx;
  height: 36rpx;
}

.paper__title {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.paper__body {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  line-height: 1.9;
  color: var(--mo-text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

.paper__sign {
  display: block;
  margin-top: 40rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--mo-brand-slate);
}
