.paper {
  background-color: var(--mo-l1-paper);
}

.paper__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.paper__main {
  flex: 1;
  min-width: 0;
}

.paper__line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.paper__who {
  width: 48rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mo-brand-teal);
  flex-shrink: 0;
}

.paper__who--mine {
  color: var(--mo-brand-rose-ink);
}

.paper__to {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.paper__meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.paper__revised {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.paper__more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-top: -12rpx;
  margin-right: -16rpx;
}

.paper__more-icon {
  width: 36rpx;
  height: 36rpx;
}

.paper__title {
  display: block;
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.paper__body {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  line-height: 1.9;
  color: var(--mo-text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

.paper__sign {
  display: block;
  margin-top: 32rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--mo-text-secondary);
}
