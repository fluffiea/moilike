<!--
  读信 · moilike-ui · Skyline —— 整页一张纸
  元信息压到最小，正文是主角；底部固定「写回信」，读完可以立刻回应。
-->
<view class="letter-detail-page">
  <app-nav title="信件" variant="glass" show-back="{{true}}" bind:back="onNavBack" />

  <scroll-view
    wx:if="{{letter}}"
    class="letter-detail-scroll"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bounces="{{true}}"
  >
    <view class="letter-read">
      <view class="letter-read__meta">
        <text class="letter-read__type">{{typeLabel}}</text>
        <text class="letter-read__sep">·</text>
        <text class="letter-read__time">{{letter.time}}</text>
      </view>

      <text wx:if="{{letter.title}}" class="letter-read__title">{{letter.title}}</text>
      <text class="letter-read__body">{{letter.content}}</text>

      <view wx:if="{{images.length > 0}}" class="letter-read__images {{images.length === 1 ? 'letter-read__images--single' : images.length === 2 ? 'letter-read__images--dual' : ''}}">
        <view wx:for="{{images}}" wx:for-index="ix" wx:key="ix" class="letter-read__image-cell">
          <image
            class="letter-read__image"
            src="{{item}}"
            mode="aspectFill"
            data-index="{{ix}}"
            bind:tap="onImageTap"
          />
        </view>
      </view>

      <text class="letter-read__sign">—— {{senderName}}</text>
    </view>
  </scroll-view>

  <view wx:else class="letter-detail-empty">
    <text class="letter-detail-empty-text">{{loading ? '加载中…' : '无法加载这封信'}}</text>
  </view>

  <view wx:if="{{letter}}" class="letter-detail-bar">
    <view class="letter-detail-reply" bind:tap="onReply" aria-role="button" aria-label="写回信">
      <text class="letter-detail-reply-text">写回信</text>
    </view>
  </view>
</view>
