<view class="mo-page">
  <app-nav title="信件" show-back />
  <scroll-view class="mo-scroll" scroll-y>
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading'}}" status="loading" rows="{{1}}" />
      <state-view wx:elif="{{status === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRetry" />

      <view wx:else class="mo-card paper">
        <view class="paper__head">
          <view class="paper__main">
            <view class="paper__line">
              <text class="paper__who {{letter.isMine ? 'paper__who--mine' : ''}}">{{letter.who}}</text>
              <text class="paper__to">{{letter.salutation}}</text>
            </view>
            <text class="paper__meta">{{letter.meta}}</text>
            <text wx:if="{{letter.revised}}" class="paper__revised">改过</text>
          </view>
          <view wx:if="{{letter.isMine}}" class="paper__more" bind:tap="onMore" aria-role="button" aria-label="更多操作">
            <image class="paper__more-icon" src="/images/icons/more.png" mode="aspectFit" />
          </view>
        </view>
        <text wx:if="{{letter.title}}" class="paper__title">{{letter.title}}</text>
        <text class="paper__body" user-select>{{letter.content}}</text>
        <image-grid images="{{letter.images}}" />
        <text class="paper__sign">{{letter.signature}}</text>
      </view>
    </view>
  </scroll-view>
</view>
