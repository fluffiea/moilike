<!--
  信箱 · moilike-ui · Skyline
  按月分组的信匣：组头是月份，卡内是「寄出/收到 + 类型 + 日 + 标题 + 摘要 + 配图」
  玫瑰点 = 我寄出，青点 = 对方寄来（与浮生头像色环一致）
-->
<view class="letter-list-page">
  <app-nav title="信件" variant="glass" show-back="{{true}}" bind:back="onNavBack" />

  <scroll-view
    class="letter-list-scroll"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bounces="{{true}}"
    lower-threshold="{{120}}"
    bind:scrolltolower="onLoadMore"
  >
    <view class="letter-list-feed">

      <view wx:if="{{loading && list.length === 0}}" class="letter-list-tip">
        <text class="letter-list-tip-text">加载中…</text>
      </view>

      <view wx:elif="{{list.length === 0 && !loading}}" class="letter-list-empty">
        <text class="letter-list-empty-title">信箱还是空的</text>
        <text class="letter-list-empty-hint">写下第一封，寄到对方心里</text>
        <view class="letter-list-empty-btn" bind:tap="onGoCompose" aria-role="button" aria-label="写一封信">
          <text class="letter-list-empty-btn-text">写一封信</text>
        </view>
      </view>

      <view wx:for="{{sections}}" wx:key="key" class="letter-mailbox">
        <view class="letter-mailbox__head">
          <text class="letter-mailbox__label">{{item.label}}</text>
          <view class="letter-mailbox__line" />
        </view>

        <view
          wx:for="{{item.items}}"
          wx:for-item="letter"
          wx:key="id"
          class="letter-card"
          data-id="{{letter.id}}"
          bind:tap="onGoDetail"
          aria-role="button"
          aria-label="{{letter.title ? letter.title : '无标题信件'}}"
        >
          <view class="letter-card__head">
            <view class="letter-card__dot {{letter.isMine ? 'letter-card__dot--sent' : 'letter-card__dot--received'}}" />
            <text class="letter-card__role">{{letter.isMine ? '寄出' : '收到'}}</text>
            <text class="letter-card__type">{{letter.typeLabel}}</text>
            <text class="letter-card__time">{{letter.dayLabel}}</text>
          </view>

          <text wx:if="{{letter.title}}" class="letter-card__title">{{letter.title}}</text>
          <text class="letter-card__preview {{letter.title ? '' : 'letter-card__preview--loose'}}">{{letter.preview}}</text>

          <view wx:if="{{letter.thumbImages.length > 0}}" class="letter-card__thumbs">
            <image
              wx:for="{{letter.thumbImages}}"
              wx:key="*this"
              class="letter-card__thumb"
              src="{{item}}"
              mode="aspectFill"
            />
          </view>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="letter-list-tip">
        <text class="letter-list-tip-text">加载更多…</text>
      </view>
      <view wx:elif="{{!hasMore && list.length > 0}}" class="letter-list-tip">
        <text class="letter-list-tip-text">— 已加载全部 —</text>
      </view>

      <view class="letter-list-pad" />
    </view>
  </scroll-view>

  <view class="letter-list-fab" bind:tap="onGoCompose" aria-role="button" aria-label="写新信">
    <view class="letter-list-fab__plus">
      <view class="letter-list-fab__bar letter-list-fab__bar--h" />
      <view class="letter-list-fab__bar letter-list-fab__bar--v" />
    </view>
  </view>
</view>
