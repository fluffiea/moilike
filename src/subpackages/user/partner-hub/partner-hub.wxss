.pair {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-bottom: 40rpx;
  padding-top: 8rpx;
}

.pair__people {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.pair__slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.pair__slot--ta {
  z-index: 1;
  margin-left: -36rpx;
}

.pair__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l1-card);
}

.pair__img {
  width: 100%;
  height: 100%;
}

.pair__initial {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.pair__mark {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.pair__mark--me {
  color: var(--mo-brand-rose-ink);
}

.pair__mark--ta {
  color: var(--mo-brand-teal);
}

.pair__name {
  display: block;
  width: 100%;
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  color: var(--mo-text-primary);
}

.pair__sign {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
  color: var(--mo-text-secondary);
}

.day__label {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.day__headline {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--mo-text-primary);
}

.day__hint {
  display: block;
  margin-top: 12rpx;
}

.day__field-label {
  display: block;
  margin-top: 32rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.day__picker {
  display: block;
  width: 100%;
}

.day__field {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.day__value {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.day__btn {
  margin-top: 32rpx;
}

.ask--line {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: var(--mo-border-field);
}

.ask__who {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.ask__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.ask__img {
  width: 100%;
  height: 100%;
}

.ask__initial {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.ask__main {
  flex: 1;
  min-width: 0;
}

.ask__name {
  display: block;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--mo-text-primary);
}

.ask__when {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.ask__actions {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.ask__no {
  flex: 1;
  margin-right: 16rpx;
}

.ask__yes {
  flex: 1;
}

.wait {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wait__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
}

.wait__img {
  width: 100%;
  height: 100%;
}

.wait__initial {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.wait__title {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  color: var(--mo-text-primary);
}

.wait__hint {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  text-align: center;
}

.code {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code__label {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.code__value {
  margin-top: 20rpx;
  padding-left: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: var(--mo-text-primary);
}

.code__copy {
  margin-top: 28rpx;
}

.code__hint {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  text-align: center;
}

.join__input {
  letter-spacing: 4rpx;
}

.join__btn {
  margin-top: 28rpx;
}
