.segment {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 80rpx;
  padding: 6rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.segment__thumb {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: calc((100% - 12rpx) / 2);
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l1-card);
  transition: transform 0.26s ease;
}

.segment__thumb--1 {
  transform: translateX(100%);
}

.segment__item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.segment__item--on {
  font-weight: 600;
  color: var(--mo-text-primary);
}

.tip {
  display: block;
  margin-top: 20rpx;
}

.link {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.link__main {
  flex: 1;
  min-width: 0;
}

.link__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.link__hint {
  display: block;
  margin-top: 8rpx;
}

.link__extra {
  margin-right: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}
