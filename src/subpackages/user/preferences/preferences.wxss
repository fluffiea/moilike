.segment {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 80rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background-color: rgba(118, 118, 128, 0.12);
}

.segment__thumb {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: calc((100% - 12rpx) / 3);
  border-radius: 18rpx;
  background-color: var(--mo-l1-card);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  transition: transform 0.26s ease;
}

.segment__thumb--1 {
  transform: translateX(100%);
}

.segment__thumb--2 {
  transform: translateX(200%);
}

.segment__item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.segment__item--on {
  font-weight: 600;
  color: var(--mo-text-primary);
}

.tip {
  display: block;
  margin-top: 20rpx;
}
