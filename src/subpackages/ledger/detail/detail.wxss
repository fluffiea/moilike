.hero__label {
  display: block;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.hero__amount {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.meta {
  margin-top: 24rpx;
}

.kv {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 0;
  border-top: var(--mo-border-field);
}

.kv__k {
  width: 96rpx;
  margin-right: 24rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.kv__v {
  flex: 1;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.rowcard {
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 104rpx;
}

.row__title {
  flex: 1;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.danger {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0;
}

.danger--busy {
  opacity: 0.45;
  pointer-events: none;
}

.danger__text {
  font-size: 32rpx;
  color: var(--mo-text-danger);
}
