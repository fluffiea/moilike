<view class="mo-page">
  <app-nav title="支出" show-back />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading'}}" status="loading" rows="{{1}}" />
      <state-view wx:elif="{{status === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRetry" />

      <block wx:elif="{{expense}}">
        <view class="mo-card">
          <text class="hero__label">{{expense.category}}</text>
          <text class="hero__amount">{{expense.amount}}</text>
          <view class="meta">
            <view class="kv">
              <text class="kv__k">时间</text>
              <text class="kv__v">{{expense.when}}</text>
            </view>
            <view wx:if="{{expense.note}}" class="kv">
              <text class="kv__k">备注</text>
              <text class="kv__v">{{expense.note}}</text>
            </view>
          </view>
        </view>

        <view class="mo-card rowcard">
          <view class="row" bind:tap="onEdit" aria-role="button">
            <text class="row__title">编辑</text>
            <image class="mo-chevron" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
        </view>

        <view class="mo-card danger {{busy ? 'danger--busy' : ''}}" bind:tap="onDelete" aria-role="button">
          <text class="danger__text">{{busy ? '正在删除' : '删除'}}</text>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
