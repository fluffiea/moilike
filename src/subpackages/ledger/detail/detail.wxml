<view class="mo-page">
  <app-nav title="详情" show-back />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading'}}" status="loading" rows="{{1}}" />
      <state-view wx:elif="{{status === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRetry" />

      <block wx:elif="{{expense}}">
        <view class="mo-card">
          <text class="hero__label">金额</text>
          <text class="hero__amount">{{expense.amount}}</text>
          <view class="kv kv--line">
            <text class="kv__k">类别</text>
            <text class="kv__v">{{expense.category}}</text>
          </view>
          <view class="kv kv--line">
            <text class="kv__k">时间</text>
            <text class="kv__v">{{expense.when}}</text>
          </view>
          <view class="kv kv--line">
            <text class="kv__k">备注</text>
            <text class="kv__v">{{expense.note}}</text>
          </view>
        </view>

        <view class="mo-card actions">
          <view class="action" bind:tap="onEdit" aria-role="button">
            <text class="action__text">编辑</text>
          </view>
          <view class="action action--line" bind:tap="onDelete" aria-role="button">
            <text class="action__text action__text--danger">删除</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
