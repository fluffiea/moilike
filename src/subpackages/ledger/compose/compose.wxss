.block {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: var(--mo-border-field);
}

.block--first {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.block__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.amount {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.amount__sign {
  margin-right: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.amount__input {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 64rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.form .mo-chip {
  background-color: var(--mo-l0-bg);
}

.form .mo-chip--on {
  background-color: var(--mo-fill-brand);
}

.when {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.when__text {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.when__text--time {
  margin-left: 24rpx;
}

.note-count {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  text-align: right;
  color: var(--mo-text-muted);
}
