.amount {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.amount__sign {
  margin-right: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.amount__input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.sheet .grid__item {
  box-sizing: border-box;
  justify-content: center;
  width: calc((100% - 48rpx) / 4);
  margin: 0 16rpx 16rpx 0;
  padding: 0;
  border-width: 0;
  background-color: var(--mo-l0-bg);
}

.sheet .grid__item:nth-child(4n) {
  margin-right: 0;
}

.sheet .grid__item.mo-chip--on {
  background-color: var(--mo-fill-brand);
}

.sub {
  padding: 24rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.sub .grid {
  margin-bottom: -16rpx;
}

.sub__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.sub .grid__item {
  background-color: var(--mo-l1-card);
  border-color: transparent;
}

.sub .grid__item.mo-chip--on {
  background-color: var(--mo-fill-brand);
}

.when {
  display: flex;
  flex-direction: row;
}

.when__item {
  flex: 1;
  margin-right: 16rpx;
}

.when__item--last {
  margin-right: 0;
}

.when__field {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.when__text {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.note {
  min-height: 88rpx;
}

.counter {
  display: block;
  margin-top: 12rpx;
  text-align: right;
}
