<view class="mo-page">
  <app-nav title="{{editId ? '编辑记账' : '记一笔'}}" show-back confirm-leave="{{leaveHint}}" />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body mo-body--sheet sheet">
      <state-view wx:if="{{loading}}" status="loading" rows="{{1}}" />
      <block wx:else>
        <view class="mo-card">
          <text class="mo-section-title">金额</text>
          <view class="amount">
            <text class="amount__sign">¥</text>
            <input
              class="amount__input"
              type="digit"
              value="{{amountInitial}}"
              maxlength="10"
              placeholder="0.00"
              placeholder-class="mo-placeholder"
              confirm-type="done"
              bindinput="onAmount"
            />
          </view>
        </view>

        <view class="mo-card">
          <text class="mo-section-title">分类</text>
          <view class="grid">
            <view
              wx:for="{{l1Options}}"
              wx:key="id"
              class="grid__item mo-chip {{item.on ? 'mo-chip--on' : ''}}"
              data-id="{{item.id}}"
              bind:tap="onPickL1"
              aria-role="button"
            >
              <text>{{item.name}}</text>
            </view>
          </view>
          <view class="sub">
            <text class="sub__label">{{l1Name}}</text>
            <view class="grid">
              <view
                wx:for="{{l2Options}}"
                wx:key="id"
                class="grid__item mo-chip {{item.on ? 'mo-chip--on' : ''}}"
                data-id="{{item.id}}"
                bind:tap="onPickL2"
                aria-role="button"
              >
                <text>{{item.name}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="mo-card">
          <text class="mo-section-title">时间</text>
          <view class="when">
            <picker class="when__item" mode="date" value="{{date}}" end="{{today}}" bindchange="onDate">
              <view class="mo-field when__field">
                <text class="when__text">{{date}}</text>
              </view>
            </picker>
            <picker class="when__item when__item--last" mode="time" value="{{time}}" bindchange="onTime">
              <view class="mo-field when__field">
                <text class="when__text">{{time}}</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="mo-card">
          <text class="mo-section-title">备注</text>
          <view class="mo-field">
            <textarea
              class="mo-textarea note"
              value="{{noteInitial}}"
              placeholder="补一句，也可以不写"
              placeholder-class="mo-placeholder"
              maxlength="50"
              auto-height
              show-confirm-bar="{{false}}"
              cursor-spacing="{{120}}"
              bindinput="onNote"
            />
          </view>
          <text class="mo-hint counter">{{noteCount}}/50</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="mo-footer">
    <view class="mo-btn {{submitting || loading ? 'mo-btn--busy' : ''}}" bind:tap="onSubmit" aria-role="button">
      <view wx:if="{{submitting}}" class="mo-spinner" />
      <text>{{submitting ? '正在保存' : (editId ? '保存' : '记下')}}</text>
    </view>
  </view>
</view>
