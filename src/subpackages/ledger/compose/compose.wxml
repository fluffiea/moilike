<view class="mo-page">
  <app-nav title="{{editId ? '编辑' : '记一笔'}}" show-back confirm-leave="{{leaveHint}}" />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body mo-body--sheet">
      <state-view wx:if="{{loading}}" status="loading" rows="{{1}}" />
      <view wx:else class="mo-card form">
        <view class="block block--first">
          <text class="block__label">金额</text>
          <view class="amount">
            <text class="amount__sign">¥</text>
            <input
              class="amount__input"
              type="digit"
              value="{{amountInitial}}"
              maxlength="10"
              placeholder="0.00"
              placeholder-class="mo-placeholder"
              confirm-type="done"
              bindinput="onAmount"
            />
          </view>
        </view>

        <view class="block">
          <text class="block__label">一级分类</text>
          <view class="mo-chips">
            <view
              wx:for="{{l1Options}}"
              wx:key="id"
              class="mo-chip {{item.on ? 'mo-chip--on' : ''}}"
              data-id="{{item.id}}"
              bind:tap="onPickL1"
              aria-role="button"
            >
              <text>{{item.name}}</text>
            </view>
          </view>
        </view>

        <view class="block">
          <text class="block__label">二级分类</text>
          <view class="mo-chips">
            <view
              wx:for="{{l2Options}}"
              wx:key="id"
              class="mo-chip {{item.on ? 'mo-chip--on' : ''}}"
              data-id="{{item.id}}"
              bind:tap="onPickL2"
              aria-role="button"
            >
              <text>{{item.name}}</text>
            </view>
          </view>
        </view>

        <view class="block">
          <text class="block__label">日期时间</text>
          <view class="when">
            <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate">
              <text class="when__text">{{date}}</text>
            </picker>
            <picker mode="time" value="{{time}}" bindchange="onTime">
              <text class="when__text when__text--time">{{time}}</text>
            </picker>
          </view>
        </view>

        <view class="block">
          <text class="block__label">备注（可选）</text>
          <view class="mo-field">
            <textarea
              class="mo-textarea note"
              value="{{noteInitial}}"
              placeholder="添加备注..."
              placeholder-class="mo-placeholder"
              maxlength="50"
              show-confirm-bar="{{false}}"
              cursor-spacing="{{120}}"
              bindinput="onNote"
            />
          </view>
          <text class="note-count">{{noteCount}}/50</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="mo-footer">
    <view class="mo-btn {{submitting ? 'mo-btn--busy' : ''}}" bind:tap="onSubmit" aria-role="button">
      <view wx:if="{{submitting}}" class="mo-spinner" />
      <text>保存</text>
    </view>
  </view>
</view>
