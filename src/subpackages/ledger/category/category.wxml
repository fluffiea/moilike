<view class="mo-page">
  <app-nav title="{{title}}" show-back />
  <scroll-view
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
    lower-threshold="{{400}}"
  >
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading' && feed.status === 'loading'}}" status="loading" />
      <state-view wx:elif="{{status === 'error' && !breakdown}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRetry" />

      <block wx:elif="{{breakdown}}">
        <view class="mo-card">
          <text class="hero__label">{{monthText}}</text>
          <text class="hero__amount">{{breakdown.totalText}}</text>
        </view>

        <view wx:if="{{!breakdown.empty}}" class="mo-card">
          <text class="mo-section-title">具体分类</text>
          <view wx:for="{{breakdown.items}}" wx:key="name" class="cat {{index ? 'cat--line' : ''}}">
            <view class="cat__top">
              <text class="cat__name">{{item.name}}</text>
              <text class="cat__pct">{{item.pct}}</text>
              <text class="cat__amt">{{item.amount}}</text>
            </view>
            <view class="track"><view class="track__fill" style="width: {{item.bar}};" /></view>
          </view>
        </view>

        <view wx:if="{{feed.status === 'ready'}}" class="mo-card">
          <text class="mo-section-title">明细</text>
          <view
            wx:for="{{feed.items}}"
            wx:key="id"
            class="bill {{index ? 'bill--line' : ''}}"
            data-id="{{item.id}}"
            bind:tap="onOpen"
            aria-role="button"
          >
            <view class="bill__main">
              <text class="bill__title">{{item.title}}</text>
              <text class="bill__meta">{{item.when}}</text>
              <text wx:if="{{item.note}}" class="bill__note" overflow="ellipsis" max-lines="1">{{item.note}}</text>
            </view>
            <text class="bill__amt">{{item.amount}}</text>
            <image class="mo-chevron bill__chevron" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
          <state-view wx:if="{{feed.more === 'loading'}}" status="more-loading" />
          <state-view wx:elif="{{feed.more === 'error'}}" status="more-error" bind:action="onLoadMore" />
          <state-view wx:elif="{{feed.more === 'end'}}" status="end" />
        </view>
        <state-view wx:elif="{{feed.status === 'loading'}}" status="loading" rows="{{2}}" />
        <state-view wx:elif="{{feed.status === 'error'}}" status="error" hint="{{feed.errorText}}" action="重试" bind:action="onRetry" />
        <state-view wx:elif="{{feed.status === 'empty'}}" status="empty" title="{{emptyTitle}}" hint="{{emptyHint}}" />
      </block>
    </view>
  </scroll-view>
</view>
