.hero__label {
  display: block;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.hero__amount {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.mo-card.rows .mo-section-title {
  margin-bottom: 0;
}

.cat {
  padding-top: 24rpx;
}

.cat--line {
  margin-top: 24rpx;
  border-top: var(--mo-border-field);
}

.cat__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cat__name {
  font-size: 32rpx;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.cat__pct {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.cat__amt {
  flex: 1;
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: right;
  color: var(--mo-text-primary);
}

.track {
  width: 100%;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l0-bg);
  overflow: hidden;
}

.track__fill {
  height: 100%;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-text-secondary);
}

.bill {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 24rpx;
}

.bill--line {
  margin-top: 24rpx;
  border-top: var(--mo-border-field);
}

.bill__main {
  flex: 1;
  min-width: 0;
}

.bill__title {
  display: block;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.bill__meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.bill__note {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.bill__amt {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.bill__chevron {
  margin-left: 16rpx;
}
