.month {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.month__label {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.month__nav {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.month__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
}

.month__icon {
  width: 28rpx;
  height: 28rpx;
}

.month__icon--prev {
  transform: rotate(180deg);
}

.month__icon--off {
  opacity: 0.35;
}

.hero__label {
  display: block;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.hero__amount {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.hero__note {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.meta {
  margin-top: 24rpx;
}

.stat {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 88rpx;
  border-top: var(--mo-border-field);
}

.stat__k {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.stat__note {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.stat__v {
  flex: 1;
  margin-left: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: right;
  color: var(--mo-text-primary);
}

.cat {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.cat__main {
  flex: 1;
  min-width: 0;
}

.cat--line {
  border-top: var(--mo-border-field);
}

.cat__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cat__name {
  font-size: 32rpx;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.cat__pct {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.cat__amt {
  flex: 1;
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: right;
  color: var(--mo-text-primary);
}

.cat__chevron {
  margin-left: 12rpx;
}

.track {
  width: 100%;
  height: 16rpx;
  margin-top: 16rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l0-bg);
  overflow: hidden;
}

.track__fill {
  height: 100%;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-text-secondary);
}

.head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.head__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.head__extra {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.bill {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.bill--line {
  border-top: var(--mo-border-field);
}

.bill__main {
  flex: 1;
  min-width: 0;
}

.bill__title {
  display: block;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.bill__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.bill__note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.bill__amt {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.bill__chevron {
  margin-left: 12rpx;
}

.lens {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 80rpx;
  margin-bottom: 32rpx;
  padding: 6rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l1-card);
  animation: ledger-in 0.28s ease both;
}

@keyframes ledger-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.lens__thumb {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: calc((100% - 12rpx) / 2);
  border-radius: var(--mo-radius-btn);
  background: var(--mo-fill-brand);
  transition: transform 0.28s ease;
}

.lens__thumb--0 {
  transform: translateX(0);
}

.lens__thumb--1 {
  transform: translateX(100%);
}

.lens__item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.lens__item--on {
  font-weight: 600;
  color: var(--mo-text-inverse);
}

.note {
  display: block;
  margin-top: 16rpx;
}
