.month {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.month__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.month__icon {
  width: 28rpx;
  height: 28rpx;
}

.month__icon--prev {
  transform: rotate(180deg);
}

.month__icon--off {
  opacity: 0.25;
}

.month__label {
  min-width: 220rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: var(--mo-text-primary);
}

.hero__label {
  display: block;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.hero__amount {
  display: block;
  margin-top: 12rpx;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.hero__open {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.summary__main {
  flex: 1;
  min-width: 0;
}

.summary__side {
  width: 196rpx;
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: var(--mo-border-field);
}

.chart-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.chart-empty {
  display: block;
  padding: 12rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.top {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
}

.rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.rank__n {
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.top__name {
  width: 64rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.top__amt {
  width: 150rpx;
  margin-left: 12rpx;
  font-size: 24rpx;
  text-align: right;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.track {
  flex: 1;
  height: 12rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l0-bg);
  overflow: hidden;
}

.track__fill {
  height: 100%;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-brand-slate);
}

.side__label {
  display: block;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.side__label--gap {
  margin-top: 28rpx;
}

.side__value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.side__note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.cat {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
}

.cat__name {
  width: 72rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.cat__pct {
  width: 108rpx;
  margin-left: 12rpx;
  font-size: 24rpx;
  text-align: right;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.cat__amt {
  width: 160rpx;
  margin-left: 8rpx;
  font-size: 24rpx;
  text-align: right;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.footnote {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.bill-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.bill-head__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.bill-head__sort {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.bill {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 0;
}

.bill--line {
  border-top: var(--mo-border-field);
}

.dot {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.bill__main {
  flex: 1;
  min-width: 0;
}

.bill__title {
  display: block;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.bill__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.bill__note {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.bill__side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.bill__amt {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.bill__when {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  text-align: right;
}
