<view class="mo-page">
  <app-nav title="记账" show-back />
  <scroll-view
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
    lower-threshold="{{400}}"
  >
    <view class="mo-body">
      <view class="month">
        <view class="month__btn" bind:tap="onPrev" aria-role="button" aria-label="上个月">
          <image class="month__icon month__icon--prev {{canPrev ? '' : 'month__icon--off'}}" src="/images/icons/chevron.png" mode="aspectFit" />
        </view>
        <text class="month__label">{{monthText}}</text>
        <view class="month__btn" bind:tap="onNext" aria-role="button" aria-label="下个月">
          <image class="month__icon {{canNext ? '' : 'month__icon--off'}}" src="/images/icons/chevron.png" mode="aspectFit" />
        </view>
      </view>

      <state-view wx:if="{{summaryStatus === 'loading' && feed.status === 'loading'}}" status="loading" />
      <state-view wx:elif="{{summaryStatus === 'error' && !summary}}" status="error" hint="{{summaryError}}" action="重试" bind:action="onRetry" />
      <state-view wx:elif="{{!summary && feed.status === 'error'}}" status="error" hint="{{feed.errorText}}" action="重试" bind:action="onRetry" />

      <block wx:elif="{{summary}}">
        <view class="mo-card hero">
          <text class="hero__label">本月合计</text>
          <text class="hero__amount">{{summary.totalText}}</text>
          <text wx:if="{{summary.open}}" class="hero__open">本月未结束</text>
        </view>

        <view class="mo-card">
          <text class="mo-section-title">月度总结</text>
          <view class="summary">
            <view class="summary__main">
              <text class="chart-label">TOP3 分类</text>
              <text wx:if="{{summary.empty}}" class="chart-empty">这个月还没有支出</text>
              <view
                wx:for="{{summary.top}}"
                wx:key="l1"
                class="top"
                data-l1="{{item.l1}}"
                bind:tap="onCategory"
                aria-role="button"
              >
                <view class="rank"><text class="rank__n">{{item.rank}}</text></view>
                <text class="top__name">{{item.name}}</text>
                <view class="track"><view class="track__fill" style="width: {{item.bar}};" /></view>
                <text class="top__amt">{{item.amount}}</text>
              </view>
            </view>
            <view class="summary__side">
              <text class="side__label">环比上月</text>
              <text class="side__value">{{summary.mom}}</text>
              <text class="side__label side__label--gap">完整月均</text>
              <text class="side__value">{{summary.avgText}}</text>
              <text class="side__note">不含本月</text>
            </view>
          </view>
        </view>

        <view class="mo-card">
          <text class="mo-section-title">一级分类分析 (L1)</text>
          <text class="chart-label">按支出金额排序</text>
          <text wx:if="{{summary.empty}}" class="chart-empty">这个月还没有支出</text>
          <view
            wx:for="{{summary.categories}}"
            wx:key="l1"
            class="cat"
            data-l1="{{item.l1}}"
            bind:tap="onCategory"
            aria-role="button"
          >
            <text class="cat__name">{{item.name}}</text>
            <view class="track"><view class="track__fill" style="width: {{item.bar}};" /></view>
            <text class="cat__pct">{{item.pct}}</text>
            <text class="cat__amt">{{item.amount}}</text>
          </view>
          <text class="footnote">注：仅展示支出类目，不含收入与转账</text>
        </view>

        <view class="mo-card">
          <view class="bill-head">
            <text class="bill-head__title">账单明细 ({{summary.count}})</text>
            <text class="bill-head__sort">按时间 ↓</text>
          </view>
          <block wx:if="{{feed.status === 'ready'}}">
            <view
              wx:for="{{feed.items}}"
              wx:key="id"
              class="bill {{index ? 'bill--line' : ''}}"
              data-id="{{item.id}}"
              bind:tap="onOpen"
              aria-role="button"
            >
              <view class="dot" />
              <view class="bill__main">
                <text class="bill__title">{{item.title}}</text>
                <text class="bill__meta">{{item.meta}}</text>
                <text wx:if="{{item.note}}" class="bill__note" overflow="ellipsis" max-lines="1">{{item.note}}</text>
              </view>
              <view class="bill__side">
                <text class="bill__amt">{{item.amount}}</text>
                <text class="bill__when">{{item.when}}</text>
              </view>
            </view>
          </block>
          <state-view wx:elif="{{feed.status === 'loading'}}" status="loading" rows="{{2}}" />
          <state-view wx:elif="{{feed.status === 'error'}}" status="error" hint="{{feed.errorText}}" action="重试" bind:action="onRetry" />
          <state-view wx:elif="{{feed.status === 'empty'}}" status="empty" title="这个月还没有支出" />
          <state-view wx:if="{{feed.status === 'ready' && feed.more === 'loading'}}" status="more-loading" />
          <state-view wx:elif="{{feed.status === 'ready' && feed.more === 'error'}}" status="more-error" bind:action="onLoadMore" />
          <state-view wx:elif="{{feed.status === 'ready' && feed.more === 'end'}}" status="end" />
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="mo-fab" bind:tap="onCompose" aria-role="button" aria-label="记一笔">
    <image class="mo-fab__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
  </view>
</view>
