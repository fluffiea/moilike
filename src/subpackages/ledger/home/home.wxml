<view class="mo-page">
  <app-nav title="记账" show-back />
  <scroll-view
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
    lower-threshold="{{400}}"
    scroll-top="{{scrollTop}}"
  >
    <view class="mo-body">
      <view class="month">
        <text class="month__label">{{monthText}}</text>
        <view class="month__nav">
          <view class="month__btn" bind:tap="onPrev" aria-role="button" aria-label="上个月">
            <image class="month__icon month__icon--prev {{canPrev ? '' : 'month__icon--off'}}" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
          <view class="month__btn" bind:tap="onNext" aria-role="button" aria-label="下个月">
            <image class="month__icon {{canNext ? '' : 'month__icon--off'}}" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
        </view>
      </view>

      <state-view wx:if="{{summaryStatus === 'loading' && feed.status === 'loading'}}" status="loading" />
      <state-view wx:elif="{{summaryStatus === 'error' && !summary}}" status="error" hint="{{summaryError}}" action="重试" bind:action="onRetry" />
      <state-view wx:elif="{{!summary && feed.status === 'error'}}" status="error" hint="{{feed.errorText}}" action="重试" bind:action="onRetry" />

      <block wx:elif="{{summary}}">
        <view class="mo-card">
          <text class="hero__label">支出</text>
          <text class="hero__amount">{{summary.totalText}}</text>
          <text wx:if="{{summary.open}}" class="hero__note">本月未结束</text>
          <view class="meta">
            <view class="stat">
              <text class="stat__k">较上月</text>
              <text class="stat__v">{{summary.mom}}</text>
            </view>
            <view class="stat">
              <text class="stat__k">月均</text>
              <text class="stat__note">不含本月</text>
              <text class="stat__v">{{summary.avgText}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{!summary.empty}}" class="mo-card">
          <text class="mo-section-title">分类</text>
          <view
            wx:for="{{summary.categories}}"
            wx:key="l1"
            class="cat {{index ? 'cat--line' : ''}}"
            data-l1="{{item.l1}}"
            bind:tap="onCategory"
            aria-role="button"
          >
            <view class="cat__main">
              <view class="cat__top">
                <text class="cat__name">{{item.name}}</text>
                <text class="cat__pct">{{item.pct}}</text>
                <text class="cat__amt">{{item.amount}}</text>
              </view>
              <view class="track"><view class="track__fill" style="width: {{item.bar}};" /></view>
            </view>
            <image class="mo-chevron cat__chevron" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
        </view>

        <view wx:if="{{feed.status === 'ready'}}" class="mo-card">
          <view class="head">
            <text class="head__title">明细</text>
            <text wx:if="{{summary.count}}" class="head__extra">{{summary.count}} 笔</text>
          </view>
          <view
            wx:for="{{feed.items}}"
            wx:key="id"
            class="bill {{index ? 'bill--line' : ''}}"
            data-id="{{item.id}}"
            bind:tap="onOpen"
            aria-role="button"
          >
            <view class="bill__main">
              <text class="bill__title">{{item.title}}</text>
              <text class="bill__meta">{{item.meta}} · {{item.when}}</text>
              <text wx:if="{{item.note}}" class="bill__note" overflow="ellipsis" max-lines="1">{{item.note}}</text>
            </view>
            <text class="bill__amt">{{item.amount}}</text>
            <image class="mo-chevron bill__chevron" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
          <state-view wx:if="{{feed.more === 'loading'}}" status="more-loading" />
          <state-view wx:elif="{{feed.more === 'error'}}" status="more-error" bind:action="onLoadMore" />
          <state-view wx:elif="{{feed.more === 'end'}}" status="end" />
        </view>
        <state-view wx:elif="{{feed.status === 'loading'}}" status="loading" rows="{{2}}" />
        <state-view wx:elif="{{feed.status === 'error'}}" status="error" hint="{{feed.errorText}}" action="重试" bind:action="onRetry" />
        <state-view wx:elif="{{feed.status === 'empty'}}" status="empty" title="这个月还没有支出" hint="记一笔就好" />
      </block>
    </view>
  </scroll-view>

  <view class="mo-fab" bind:tap="onCompose" aria-role="button" aria-label="记一笔">
    <image class="mo-fab__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
  </view>
</view>
