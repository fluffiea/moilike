<view class="mo-page">
  <app-nav title="记账" show-back />
  <scroll-view
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
    lower-threshold="{{400}}"
    scroll-top="{{scrollTop}}"
  >
    <view class="mo-body">
      <view wx:if="{{showLens}}" class="lens">
        <view class="lens__thumb lens__thumb--{{lensIndex}}" />
        <view
          wx:for="{{lenses}}"
          wx:key="value"
          class="lens__item {{lensIndex === idx ? 'lens__item--on' : ''}}"
          wx:for-index="idx"
          data-index="{{idx}}"
          bind:tap="onLens"
          aria-role="tab"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <view class="month">
        <text class="month__label">{{monthText}}</text>
        <view class="month__nav">
          <view class="month__btn" bind:tap="onPrev" aria-role="button" aria-label="上个月">
            <image class="month__icon month__icon--prev {{canPrev ? '' : 'month__icon--off'}}" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
          <view class="month__btn" bind:tap="onNext" aria-role="button" aria-label="下个月">
            <image class="month__icon {{canNext ? '' : 'month__icon--off'}}" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
        </view>
      </view>

      <block wx:for="{{panes}}" wx:for-item="pane" wx:for-index="pi" wx:key="heroLabel">
        <view wx:if="{{pi === lensIndex}}">
          <state-view wx:if="{{pane.summaryStatus === 'loading' && pane.feed.status === 'loading'}}" status="loading" />
          <state-view wx:elif="{{pane.summaryStatus === 'error' && !pane.summary}}" status="error" hint="{{pane.summaryError}}" action="重试" bind:action="onRetry" />
          <state-view wx:elif="{{!pane.summary && pane.feed.status === 'error'}}" status="error" hint="{{pane.feed.errorText}}" action="重试" bind:action="onRetry" />

          <block wx:elif="{{pane.summary}}">
            <view class="mo-card">
              <text class="hero__label">{{pane.heroLabel}}</text>
              <text class="hero__amount">{{pane.summary.totalText}}</text>
              <text wx:if="{{pane.summary.open}}" class="hero__note">本月未结束</text>
              <view class="meta">
                <view class="stat">
                  <text class="stat__k">较上月</text>
                  <text class="stat__v">{{pane.summary.mom}}</text>
                </view>
                <view class="stat">
                  <text class="stat__k">月均</text>
                  <text class="stat__note">不含本月</text>
                  <text class="stat__v">{{pane.summary.avgText}}</text>
                </view>
              </view>
              <text wx:if="{{pane.summaryNote && pane.summary.empty}}" class="mo-hint note">{{pane.summaryNote}}</text>
            </view>

            <view wx:if="{{!pane.summary.empty}}" class="mo-card">
              <text class="mo-section-title">分类</text>
              <view
                wx:for="{{pane.summary.categories}}"
                wx:key="l1"
                class="cat {{index ? 'cat--line' : ''}}"
                data-l1="{{item.l1}}"
                bind:tap="onCategory"
                aria-role="button"
              >
                <view class="cat__main">
                  <view class="cat__top">
                    <text class="cat__name">{{item.name}}</text>
                    <text class="cat__pct">{{item.pct}}</text>
                    <text class="cat__amt">{{item.amount}}</text>
                  </view>
                  <view class="track"><view class="track__fill" style="width: {{item.bar}};" /></view>
                </view>
                <image wx:if="{{pane.canDrill}}" class="mo-chevron cat__chevron" src="/images/icons/chevron.png" mode="aspectFit" />
              </view>
              <text wx:if="{{pane.summaryNote}}" class="mo-hint note">{{pane.summaryNote}}</text>
            </view>

            <block wx:if="{{pane.showList}}">
              <view wx:if="{{pane.feed.status === 'ready'}}" class="mo-card">
                <view class="head">
                  <text class="head__title">明细</text>
                  <text wx:if="{{pane.summary.count}}" class="head__extra">{{pane.summary.count}} 笔</text>
                </view>
                <view
                  wx:for="{{pane.feed.items}}"
                  wx:key="id"
                  class="bill {{index ? 'bill--line' : ''}}"
                  data-id="{{item.id}}"
                  bind:tap="onOpen"
                  aria-role="button"
                >
                  <view class="bill__main">
                    <text class="bill__title">{{item.title}}</text>
                    <text class="bill__meta">{{item.meta}} · {{item.when}}</text>
                    <text wx:if="{{item.note}}" class="bill__note" overflow="ellipsis" max-lines="1">{{item.note}}</text>
                  </view>
                  <text class="bill__amt">{{item.amount}}</text>
                  <image class="mo-chevron bill__chevron" src="/images/icons/chevron.png" mode="aspectFit" />
                </view>
                <state-view wx:if="{{pane.feed.more === 'loading'}}" status="more-loading" />
                <state-view wx:elif="{{pane.feed.more === 'error'}}" status="more-error" bind:action="onLoadMore" />
                <state-view wx:elif="{{pane.feed.more === 'end'}}" status="end" />
              </view>
              <state-view wx:elif="{{pane.feed.status === 'loading'}}" status="loading" rows="{{2}}" />
              <state-view wx:elif="{{pane.feed.status === 'error'}}" status="error" hint="{{pane.feed.errorText}}" action="重试" bind:action="onRetry" />
              <state-view wx:elif="{{pane.feed.status === 'empty'}}" status="empty" title="{{pane.emptyTitle}}" hint="{{pane.emptyHint}}" />
            </block>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="mo-fab" bind:tap="onCompose" aria-role="button" aria-label="记一笔">
    <image class="mo-fab__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
  </view>
</view>
