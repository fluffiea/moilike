.list {
  padding: 8rpx var(--mo-pad-h);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.row--line {
  border-top: var(--mo-border-field);
}

.row__main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.row__name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.row__tags {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.note {
  min-height: 160rpx;
}

.submit__note {
  display: block;
  margin-bottom: 16rpx;
}

.submit {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.submit__count {
  flex: 1;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.submit__btn {
  width: 280rpx;
}
