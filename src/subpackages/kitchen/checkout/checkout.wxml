<view class="mo-page">
  <app-nav title="确认下单" show-back confirm-leave="{{leaveHint}}" />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body mo-body--sheet">
      <view class="mo-card list">
        <view wx:for="{{rows}}" wx:key="key" class="row {{index ? 'row--line' : ''}}">
          <view class="thumb">
            <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="thumb__ph"><text class="thumb__txt">暂无</text></view>
          </view>
          <view class="row__main">
            <text class="row__name">{{item.name}} ×{{item.quantity}}</text>
          </view>
          <view class="mo-step">
            <view class="mo-step__btn" data-key="{{item.key}}" data-dir="-1" bind:tap="onStep" aria-role="button"><text class="mo-step__mark">－</text></view>
            <text class="mo-step__num">{{item.quantity}}</text>
            <view class="mo-step__btn" data-key="{{item.key}}" data-dir="1" bind:tap="onStep" aria-role="button"><text class="mo-step__mark">＋</text></view>
          </view>
        </view>
      </view>
      <view class="mo-card">
        <text class="mo-section-title">备注</text>
        <view class="mo-field">
          <textarea
            class="mo-textarea note"
            value="{{note}}"
            maxlength="80"
            placeholder="写给 Ta 的一句，也可以不写"
            placeholder-class="mo-placeholder"
            auto-height
            show-confirm-bar="{{false}}"
            bindinput="onNote"
          />
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="mo-footer">
    <text wx:if="{{preview}}" class="mo-hint submit__note">自己的厨房只能预览，不能提交</text>
    <view class="submit">
      <text class="submit__count">共 {{portions}} 份</text>
      <view class="mo-btn {{preview ? 'mo-btn--disabled' : ''}} {{submitting ? 'mo-btn--busy' : ''}} submit__btn" bind:tap="onSubmit" aria-role="button">
        <view wx:if="{{submitting}}" class="mo-spinner" />
        <text>提交订单</text>
      </view>
    </view>
  </view>
</view>
