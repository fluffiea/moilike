.bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 28rpx;
}

.bar__name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.bar__act {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

.seg {
  display: flex;
  flex-direction: row;
  height: 80rpx;
  margin-bottom: 36rpx;
  padding: 6rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l1-card);
}

.seg__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: var(--mo-radius-btn);
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.seg__item--on {
  background-color: var(--mo-fill-brand);
  color: var(--mo-text-inverse);
  font-weight: 600;
}

.job__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.avatar__img {
  width: 100%;
  height: 100%;
}

.avatar__initial {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.job__who {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.job__side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.job__time {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.job__status {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.job__names {
  display: block;
  margin-top: 20rpx;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.job__note {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.job__act {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 20rpx;
}
