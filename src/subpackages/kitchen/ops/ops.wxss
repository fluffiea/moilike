.hero {
  margin-bottom: 32rpx;
}

.hero__name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.hero__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.manage {
  padding: 8rpx 32rpx;
}

.mrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
}

.mrow--line {
  border-top: var(--mo-border-field);
}

.mrow__title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.tabs {
  margin-bottom: 20rpx;
}

.job__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.avatar__img {
  width: 100%;
  height: 100%;
}

.avatar__initial {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.job__main {
  flex: 1;
  min-width: 0;
}

.job__name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.job__time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.job__status {
  margin-left: 16rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.job__line {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.job__top + .job__line {
  margin-top: 20rpx;
}

.job__note {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.job__act {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 20rpx;
}
