<view class="mo-page">
  <app-nav title="管理分类" show-back />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body mo-body--sheet">
      <state-view wx:if="{{loading}}" status="loading" rows="{{2}}" />
      <view wx:elif="{{rows.length === 0}}" class="mo-card blank">
        <text class="blank__title">还没有分类</text>
        <text class="mo-hint blank__hint">厨房是空的，先新增一个分类</text>
        <text class="mo-hint blank__hint">分类全部由你自定义，无系统预置</text>
      </view>
      <block wx:else>
        <view wx:for="{{rows}}" wx:key="id" class="mo-card row">
          <view class="row__main">
            <text class="row__title">{{item.name}}</text>
            <text class="row__meta">{{item.meta}}</text>
          </view>
          <text class="row__act" data-id="{{item.id}}" bind:tap="onRename" aria-role="button">改名</text>
          <text class="row__act row__act--danger" data-id="{{item.id}}" bind:tap="onRemove" aria-role="button">删除</text>
        </view>
      </block>
      <text class="mo-hint foot-hint">仅可删除无菜品的分类。本期不做拖拽排序。</text>
    </view>
  </scroll-view>
  <view class="mo-footer">
    <view class="mo-btn" bind:tap="onAdd" aria-role="button"><text>新增分类</text></view>
  </view>
</view>
