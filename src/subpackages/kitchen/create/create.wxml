<view class="mo-page">
  <app-nav title="我的厨房" show-back />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body mo-body--sheet">
      <state-view wx:if="{{phase === 'loading'}}" status="loading" rows="{{1}}" />
      <state-view wx:elif="{{phase === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="prepare" />
      <view wx:else class="mo-card create">
        <text class="create__title">给厨房起个名字</text>
        <text class="mo-hint create__lead">对方在点单里会看到这个名字。</text>
        <text class="create__label">厨房名</text>
        <view class="mo-field">
          <input
            class="mo-input"
            maxlength="20"
            value="{{name}}"
            placeholder="例如阿柚的小厨房"
            placeholder-class="mo-placeholder"
            bindinput="onName"
          />
        </view>
        <text class="mo-hint create__note">创建之后是空厨房，先加分类，再挂菜。</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{phase === 'form'}}" class="mo-footer">
    <view class="mo-btn {{submitting ? 'mo-btn--busy' : ''}}" bind:tap="onCreate" aria-role="button">
      <view wx:if="{{submitting}}" class="mo-spinner" />
      <text>创建厨房</text>
    </view>
  </view>
</view>
