<view class="mo-page">
  <app-nav title="菜单管理" show-back />
  <scroll-view class="mo-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="mo-body">
      <state-view wx:if="{{status === 'loading'}}" status="loading" rows="{{2}}" />
      <state-view wx:elif="{{status === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="reload" />
      <block wx:else>
        <view class="hero">
          <text class="hero__name" overflow="ellipsis" max-lines="1">{{kitchenName}}</text>
          <text class="hero__sub">管好菜单，Ta 的点单页会同步变化</text>
        </view>

        <view class="mo-card manage">
          <view class="mrow" bind:tap="onCategories" aria-role="button">
            <text class="mrow__title">管理分类</text>
            <image class="mo-chevron" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
          <view class="mrow mrow--line" bind:tap="onRename" aria-role="button">
            <text class="mrow__title">厨房改名</text>
            <image class="mo-chevron" src="/images/icons/chevron.png" mode="aspectFit" />
          </view>
        </view>

        <view wx:if="{{empty}}" class="mo-card mo-guide">
          <text class="mo-guide__title">还没有菜品</text>
          <text class="mo-hint mo-guide__hint">从右下角加一道菜；没有分类可先起一个</text>
        </view>
        <block wx:else>
          <view wx:for="{{groups}}" wx:key="id" class="group">
            <text class="mo-section-title">{{item.name}}</text>
            <view class="mo-card group__card">
              <view
                wx:for="{{item.dishes}}"
                wx:for-item="dish"
                wx:key="id"
                class="row {{index ? 'row--line' : ''}} {{dish.off ? 'row--off' : ''}}"
                data-id="{{dish.id}}"
                bind:tap="onOpen"
                aria-role="button"
              >
                <view class="thumb">
                  <image wx:if="{{dish.cover}}" class="thumb__img" src="{{dish.cover}}" mode="aspectFill" />
                  <view wx:else class="thumb__ph" />
                </view>
                <view class="row__main">
                  <text class="row__title">{{dish.name}}</text>
                  <text wx:if="{{dish.desc}}" class="row__desc">{{dish.desc}}</text>
                </view>
                <text class="row__shelf {{dish.off ? 'row__shelf--off' : ''}}">{{dish.shelf}}</text>
                <image class="mo-chevron" src="/images/icons/chevron.png" mode="aspectFit" />
              </view>
            </view>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>
  <view wx:if="{{status === 'ready'}}" class="mo-fab" bind:tap="onCreate" aria-role="button" aria-label="新建菜品">
    <image class="mo-fab__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
  </view>
</view>
