.hero {
  margin-bottom: 32rpx;
}

.hero__name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.hero__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.manage {
  padding: 8rpx 32rpx;
}

.mrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
}

.mrow--line {
  border-top: var(--mo-border-field);
}

.mrow__title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.group__card {
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.row--line {
  border-top: var(--mo-border-field);
}

.row--off .row__title {
  color: var(--mo-text-muted);
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  margin-right: 20rpx;
  border-radius: var(--mo-radius-inner);
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.thumb__img {
  width: 100%;
  height: 100%;
}

.thumb__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.row__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.row__shelf {
  margin-right: 8rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.row__shelf--off {
  color: var(--mo-text-muted);
}
