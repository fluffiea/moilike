.bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.bar__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.bar__act {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

.group__card {
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.row--line {
  border-top: var(--mo-border-field);
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  margin-right: 20rpx;
  border-radius: var(--mo-radius-inner);
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.thumb__img {
  width: 100%;
  height: 100%;
}

.thumb__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.row__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.row__shelf {
  margin-right: 8rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.row__shelf--off {
  color: var(--mo-text-muted);
}
