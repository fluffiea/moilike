/* 设计令牌：组件内同样可用（CSS 变量沿组件树继承） */
page {
  --mo-l0-bg: #f2f2f7;
  --mo-l1-card: #ffffff;
  --mo-l1-accent: #f7f7fa;

  --mo-text-primary: #1c1c1e;
  --mo-text-secondary: #8e8e93;
  --mo-text-muted: #aeaeb2;
  --mo-text-inverse: #ffffff;
  --mo-text-danger: #c25b5b;

  --mo-brand-teal: #668f80;
  --mo-brand-slate: #4a6670;
  --mo-brand-rose: #d6a2ad;
  --mo-brand-rose-ink: #a86e7b;
  --mo-brand-sand: #c3b59f;

  --mo-status-pending: #e8a87c;
  --mo-status-pending-text: #c07a5e;
  --mo-status-read: #6bbf8a;
  --mo-status-read-text: #4a9a6a;
  --mo-status-evaluated: #9b8ec4;
  --mo-status-evaluated-text: #7b6ea8;

  --mo-l1-paper: #f4efe8;
  --mo-fill-brand: #4a6670;
  --mo-skeleton: #ececf1;

  --mo-border-field: 1rpx solid rgba(0, 0, 0, 0.06);

  --mo-radius-card: 40rpx;
  --mo-radius-inner: 24rpx;
  --mo-radius-btn: 999rpx;
  --mo-radius-chip: 999rpx;

  --mo-pad-h: 32rpx;
  --mo-safe-bottom: env(safe-area-inset-bottom);

  height: 100vh;
  background-color: var(--mo-l0-bg);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ---------- 页面骨架：导航 + 可滚动主体 ---------- */
.mo-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.mo-scroll {
  flex: 1;
  height: 0;
}

.mo-body {
  padding: 32rpx var(--mo-pad-h) calc(220rpx + var(--mo-safe-bottom));
}

.mo-body--sheet {
  padding-bottom: calc(200rpx + var(--mo-safe-bottom));
}

.mo-card {
  margin-bottom: 36rpx;
  padding: 32rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.mo-section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.mo-hint {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}

.mo-chevron {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* ---------- 日期分隔 ---------- */
.mo-day {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0 20rpx;
}

.mo-day__line {
  display: none;
}

.mo-day__label {
  margin: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--mo-text-secondary);
}

/* ---------- 按钮：busy 时显示转圈并屏蔽点击 ---------- */
.mo-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--mo-radius-btn);
  background: var(--mo-fill-brand);
  color: var(--mo-text-inverse);
  font-size: 32rpx;
  font-weight: 600;
}

.mo-btn--warm {
  background: var(--mo-fill-brand);
}

.mo-btn--ghost {
  background: var(--mo-l0-bg);
  color: var(--mo-brand-slate);
}

.mo-btn--small {
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.mo-btn--disabled {
  opacity: 0.45;
}

.mo-btn--busy {
  opacity: 0.8;
  pointer-events: none;
}

.mo-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: #ffffff;
  animation: mo-spin 0.8s linear infinite;
}

@keyframes mo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ---------- 底部操作栏（发布 / 回复 / 评论） ---------- */
.mo-footer {
  padding: 20rpx var(--mo-pad-h) calc(20rpx + var(--mo-safe-bottom));
  background: rgba(242, 242, 247, 0.88);
  backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* ---------- 悬浮新建按钮：高于 TabBar，避开 Home Indicator ---------- */
.mo-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + var(--mo-safe-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--mo-fill-brand);
  box-shadow: 0 8px 24px rgba(28, 28, 30, 0.16);
}

.mo-fab--brand {
  background: var(--mo-fill-brand);
}

.mo-fab__icon {
  width: 40rpx;
  height: 40rpx;
}

/* ---------- 表单 ---------- */
.mo-field {
  padding: 0 28rpx;
  border-radius: var(--mo-radius-inner);
  border: var(--mo-border-field);
  background-color: var(--mo-l0-bg);
}

/* Skyline 下 input 必须显式 height + line-height，否则塌成一条线 */
.mo-input {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.mo-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--mo-text-primary);
}

.mo-placeholder {
  color: var(--mo-text-muted);
}

.mo-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 60rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 0 28rpx;
  border-radius: var(--mo-radius-chip);
  border: var(--mo-border-field);
  background-color: var(--mo-l1-accent);
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.mo-chip--on {
  border-color: transparent;
  background: var(--mo-fill-brand);
  color: var(--mo-text-inverse);
}

.mo-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

/* 回到顶部 */
.mo-back-top {
  position: fixed;
  right: 40rpx;
  bottom: calc(168rpx + var(--mo-safe-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6px 20px rgba(28, 28, 30, 0.1);
}

.mo-back-top__icon {
  width: 32rpx;
  height: 32rpx;
  transform: rotate(-90deg);
}
