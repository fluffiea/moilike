/* 设计令牌：组件内同样可用（CSS 变量沿组件树继承） */
page {
  --mo-l0-bg: #f2f2f7;
  --mo-l1-card: #ffffff;
  --mo-l1-accent: #f7f7fa;

  --mo-text-primary: #1c1c1e;
  --mo-text-secondary: #8e8e93;
  --mo-text-muted: #aeaeb2;
  --mo-text-inverse: #ffffff;
  --mo-text-danger: #c25b5b;

  --mo-brand-teal: #668f80;
  --mo-brand-slate: #4a6670;
  --mo-brand-rose: #d6a2ad;
  --mo-brand-sand: #c3b59f;

  --mo-status-pending: #e8a87c;
  --mo-status-pending-text: #c07a5e;
  --mo-status-read: #6bbf8a;
  --mo-status-read-text: #4a9a6a;
  --mo-status-evaluated: #9b8ec4;
  --mo-status-evaluated-text: #7b6ea8;

  --mo-gradient-brand: linear-gradient(155deg, #668f80 0%, #4a6670 100%);
  --mo-gradient-warm: linear-gradient(155deg, #d6a2ad 0%, #c3b59f 100%);
  --mo-skeleton: #ececf1;

  --mo-shadow-card: 0 4px 12px rgba(0, 0, 0, 0.02), 0 12px 32px rgba(0, 0, 0, 0.04);
  --mo-border-card: 1rpx solid rgba(0, 0, 0, 0.04);
  --mo-border-field: 1rpx solid rgba(0, 0, 0, 0.06);

  --mo-radius-card: 48rpx;
  --mo-radius-inner: 28rpx;
  --mo-radius-btn: 28rpx;
  --mo-radius-chip: 999rpx;

  --mo-pad-h: 32rpx;
  --mo-safe-bottom: env(safe-area-inset-bottom);

  height: 100vh;
  background-color: var(--mo-l0-bg);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ---------- 页面骨架：导航 + 可滚动主体 ---------- */
.mo-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.mo-scroll {
  flex: 1;
  height: 0;
}

.mo-body {
  padding: 32rpx var(--mo-pad-h) calc(220rpx + var(--mo-safe-bottom));
}

.mo-body--sheet {
  padding-bottom: calc(200rpx + var(--mo-safe-bottom));
}

.mo-card {
  margin-bottom: 24rpx;
  padding: 36rpx;
  border-radius: var(--mo-radius-card);
  border: var(--mo-border-card);
  background-color: var(--mo-l1-card);
  box-shadow: var(--mo-shadow-card);
}

.mo-section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.mo-hint {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}

/* ---------- 日期分隔 ---------- */
.mo-day {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 8rpx 20rpx;
}

.mo-day__line {
  flex: 1;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

.mo-day__label {
  margin: 0 20rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

/* ---------- 按钮：busy 时显示转圈并屏蔽点击 ---------- */
.mo-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 40rpx;
  border-radius: var(--mo-radius-btn);
  background: var(--mo-gradient-brand);
  color: var(--mo-text-inverse);
  font-size: 30rpx;
  font-weight: 600;
}

.mo-btn--warm {
  background: var(--mo-gradient-warm);
}

.mo-btn--ghost {
  background: var(--mo-l1-accent);
  color: var(--mo-brand-slate);
  border: var(--mo-border-field);
}

.mo-btn--small {
  height: 72rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: 22rpx;
}

.mo-btn--disabled {
  opacity: 0.45;
}

.mo-btn--busy {
  opacity: 0.8;
  pointer-events: none;
}

.mo-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: #ffffff;
  animation: mo-spin 0.8s linear infinite;
}

@keyframes mo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ---------- 底部操作栏（发布 / 回复 / 评论） ---------- */
.mo-footer {
  padding: 20rpx var(--mo-pad-h) calc(20rpx + var(--mo-safe-bottom));
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* ---------- 悬浮新建按钮：高于 TabBar，避开 Home Indicator ---------- */
.mo-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + var(--mo-safe-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 40rpx;
  background: var(--mo-gradient-warm);
  box-shadow: 0 12px 32px rgba(214, 162, 173, 0.32);
}

.mo-fab--brand {
  background: var(--mo-gradient-brand);
  box-shadow: 0 12px 32px rgba(74, 102, 112, 0.28);
}

.mo-fab__plus {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

.mo-fab__bar {
  position: absolute;
  border-radius: 3rpx;
  background-color: #ffffff;
}

.mo-fab__bar--h {
  left: 0;
  right: 0;
  top: 18rpx;
  height: 5rpx;
}

.mo-fab__bar--v {
  top: 0;
  bottom: 0;
  left: 18rpx;
  width: 5rpx;
}

/* ---------- 表单 ---------- */
.mo-field {
  padding: 0 28rpx;
  border-radius: var(--mo-radius-inner);
  border: var(--mo-border-field);
  background-color: var(--mo-l1-accent);
}

/* Skyline 下 input 必须显式 height + line-height，否则塌成一条线 */
.mo-input {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: var(--mo-text-primary);
}

.mo-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--mo-text-primary);
}

.mo-placeholder {
  color: var(--mo-text-muted);
}

.mo-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 60rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 0 28rpx;
  border-radius: var(--mo-radius-chip);
  border: var(--mo-border-field);
  background-color: var(--mo-l1-accent);
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.mo-chip--on {
  border-color: transparent;
  background: var(--mo-gradient-brand);
  color: var(--mo-text-inverse);
}

.mo-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

/* 回到顶部 */
.mo-back-top {
  position: fixed;
  right: 44rpx;
  bottom: calc(176rpx + var(--mo-safe-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: var(--mo-border-field);
}

.mo-back-top__arrow {
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
  border-left: 4rpx solid var(--mo-brand-slate);
  border-top: 4rpx solid var(--mo-brand-slate);
  transform: rotate(45deg);
}
