.identity {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 36rpx 40rpx;
}

.identity__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l1-card);
  box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.08);
}

.identity__img {
  width: 100%;
  height: 100%;
}

.identity__initial {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.identity__name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.identity__sign {
  margin-top: 12rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--mo-text-secondary);
}

.list {
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 104rpx;
}

.row--line {
  border-top: var(--mo-border-field);
}

.row__lead {
  margin-right: 24rpx;
}

.row__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--mo-l1-accent);
}

.row__avatar--empty {
  box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.12);
}

.row__main {
  flex: 1;
  min-width: 0;
  padding: 24rpx 0;
}

.row__title {
  display: block;
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.row__hint {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.row__extra {
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.logout {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0;
}

.logout__text {
  font-size: 32rpx;
  color: var(--mo-text-danger);
}
