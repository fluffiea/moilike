.top {
  height: 32rpx;
}

.end {
  height: calc(200rpx + var(--mo-safe-bottom));
}

.row {
  margin: 0 var(--mo-pad-h);
}

.letter {
  padding: 32rpx;
  background-color: var(--mo-l1-paper);
}

.letter__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.letter__who {
  width: 48rpx;
  margin-top: 6rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mo-brand-teal);
  flex-shrink: 0;
}

.letter__who--mine {
  color: var(--mo-brand-rose-ink);
}

.letter__main {
  flex: 1;
  min-width: 0;
}

.letter__to {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.letter__meta {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.letter__title {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.letter__preview {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--mo-text-secondary);
}

.letter__thumbs {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.letter__thumb {
  width: 120rpx;
  height: 120rpx;
  margin-right: 12rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.letter__thumb:last-child {
  margin-right: 0;
}
