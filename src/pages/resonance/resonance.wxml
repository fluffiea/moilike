<view class="mo-page">
  <app-nav title="共鸣" large="{{true}}" />

  <block wx:if="{{bound}}">
    <view class="filters">
      <view class="filter {{filter === 'all' ? 'filter--on' : ''}}" data-key="all" bind:tap="onFilterTap" aria-role="tab">
        <text>全部</text>
      </view>
      <view class="filter {{filter === 'await_me' ? 'filter--on' : ''}}" data-key="await_me" bind:tap="onFilterTap" aria-role="tab">
        <text>等我回声</text>
        <text wx:if="{{awaitMeCount > 0}}" class="filter__count">{{awaitMeCount}}</text>
      </view>
      <view class="filters__fill" />
      <view class="echoes-link" bind:tap="onEchoes" aria-role="button">
        <text class="echoes-link__text">已共鸣</text>
        <image class="echoes-link__icon" src="/images/icons/chevron.png" mode="aspectFit" />
      </view>
    </view>

    <scroll-view
      class="mo-scroll"
      scroll-y
      type="list"
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-triggered="{{feed.refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLoadMore"
      bindscroll="onScroll"
      lower-threshold="{{400}}"
      scroll-top="{{scrollTop}}"
      scroll-with-animation
    >
      <view class="list-top" />
      <view wx:for="{{feed.items}}" wx:key="id" class="row">
        <view wx:if="{{item.day}}" class="mo-day">
          <text class="mo-day__label">{{item.day}}</text>
        </view>
        <report-card post="{{item}}" bind:open="onOpen" bind:more="onMore" bind:quick="onQuick" />
      </view>

      <view class="row">
        <state-view wx:if="{{feed.status === 'loading'}}" status="loading" />
        <state-view wx:elif="{{feed.status === 'error'}}" status="error" hint="{{feed.errorText}}" action="重试" bind:action="onRetry" />
        <state-view
          wx:elif="{{feed.status === 'empty'}}"
          status="empty"
          title="{{empty.title}}"
          hint="{{empty.hint}}"
          action="{{empty.action}}"
          bind:action="onCompose"
        />
        <state-view wx:elif="{{feed.more === 'loading'}}" status="more-loading" />
        <state-view wx:elif="{{feed.more === 'error'}}" status="more-error" bind:action="onLoadMore" />
        <state-view wx:elif="{{feed.more === 'end'}}" status="end" />
      </view>
      <view class="list-end" />
    </scroll-view>

    <view wx:if="{{showTop}}" class="mo-back-top" bind:tap="onBackTop" aria-role="button" aria-label="回到顶部">
      <image class="mo-back-top__icon" src="/images/icons/chevron.png" mode="aspectFit" />
    </view>
    <view class="mo-fab" bind:tap="onCompose" aria-role="button" aria-label="写报备">
      <image class="mo-fab__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
    </view>

    <view wx:if="{{quickId}}" class="mo-mask" bind:tap="onCloseQuick">
      <view class="mo-sheet" catch:tap="noop">
        <view class="mo-sheet__handle" />
        <text class="mo-section-title">{{respondTitle}}</text>
        <text wx:if="{{quickPreview}}" class="sheet__which" overflow="ellipsis" max-lines="1">{{quickPreview}}</text>
        <text class="mo-hint sheet__hint">{{respondHint}}</text>
        <sticker-grid stickers="{{stickers}}" busy="{{quickBusy}}" bind:pick="onQuickSticker" />
      </view>
    </view>
  </block>

  <scroll-view wx:else class="mo-scroll" scroll-y>
    <view class="mo-body">
      <view class="mo-card mo-guide">
        <text class="mo-guide__title">先结伴，才能听见彼此</text>
        <text class="mo-hint mo-guide__hint">共鸣里的报备和回声，只属于结伴的两个人</text>
        <view class="mo-btn guide__btn" bind:tap="onBind" aria-role="button">
          <text>去结伴</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
