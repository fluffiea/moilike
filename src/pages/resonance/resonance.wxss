.filters {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 var(--mo-pad-h);
}

.filter {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 64rpx;
  height: 80rpx;
  margin-right: 48rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.filter--on {
  font-weight: 600;
  color: var(--mo-text-primary);
}

.filter__count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.filter--on .filter__count {
  color: var(--mo-text-secondary);
}

.filters__fill {
  flex: 1;
  min-width: 16rpx;
}

/* 筛选行右侧：翻到只读的已共鸣档案 */
.echoes-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 80rpx;
  flex-shrink: 0;
}

.echoes-link__text {
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

.echoes-link__icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.list-top {
  height: 8rpx;
}

.list-end {
  height: calc(200rpx + var(--mo-safe-bottom));
}

.row {
  margin: 0 var(--mo-pad-h);
}

.guide__btn {
  margin-top: 40rpx;
}

.sheet__which {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.sheet__hint {
  display: block;
  margin-top: 8rpx;
}
