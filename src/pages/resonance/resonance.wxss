.tabs {
  flex-shrink: 0;
  padding: 32rpx var(--mo-pad-h) 0;
}

.tabs__rail {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 80rpx;
  padding: 6rpx;
  border-radius: var(--mo-radius-btn);
  background-color: var(--mo-l1-card);
}

/* 指示块按下标平移，切换时有过渡 */
.tabs__thumb {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: calc((100% - 12rpx) / 3);
  border-radius: var(--mo-radius-btn);
  background: var(--mo-fill-brand);
  transition: transform 0.26s ease;
}

.tabs__thumb--1 {
  transform: translateX(100%);
}

.tabs__thumb--2 {
  transform: translateX(200%);
}

.tabs__item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.tabs__item--on {
  font-weight: 600;
  color: var(--mo-text-inverse);
}

.tabs__count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.tabs__item--on .tabs__count {
  color: var(--mo-text-inverse);
}

.panes {
  flex: 1;
  height: 0;
}

.pane {
  height: 100%;
}

.pane__top {
  height: 32rpx;
}

.pane__end {
  height: calc(200rpx + var(--mo-safe-bottom));
}

.row {
  margin: 0 var(--mo-pad-h);
}

.banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 36rpx;
}

.banner__text {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.banner .mo-btn {
  flex-shrink: 0;
}
