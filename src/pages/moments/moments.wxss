.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 24rpx var(--mo-pad-h) 16rpx;
}

.toolbar__picker {
  flex: 1;
}

.toolbar__label {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 64rpx;
}

.toolbar__text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--mo-text-secondary);
}

.toolbar__caret {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
  transform: rotate(90deg);
}

.toolbar__clear {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
}

.toolbar__clear-text {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.row {
  margin: 0 var(--mo-pad-h);
}

.banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 36rpx;
  padding: 28rpx 32rpx;
}

.banner__text {
  flex: 1;
  margin-right: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}

.feed-end {
  height: calc(200rpx + var(--mo-safe-bottom));
}
