<view class="mo-page">
  <app-nav title="朝夕" large="{{true}}" />
  <scroll-view class="mo-scroll" scroll-y>
    <view class="mo-body">
      <view wx:if="{{scene === 'needPartner'}}" class="mo-card guide">
        <text class="guide__title">先把 Ta 接到身边</text>
        <text class="mo-hint">朝夕、素笺只属于结伴的两个人。绑定之后，这里会为你们亮起一盏小小的计时灯。</text>
        <view class="mo-btn guide__btn" bind:tap="onOpenPartnerHub" aria-role="button">
          <text>去结伴</text>
        </view>
      </view>

      <block wx:else>
        <view class="hero">
          <view class="pair">
            <view class="pair__avatar">
              <image wx:if="{{me.avatarUrl}}" class="pair__img" src="{{me.avatarUrl}}" mode="aspectFill" data-who="me" binderror="onAvatarError" />
              <text wx:else class="pair__initial">{{me.initial}}</text>
            </view>
            <view class="pair__avatar pair__avatar--overlap">
              <image wx:if="{{partner.avatarUrl}}" class="pair__img" src="{{partner.avatarUrl}}" mode="aspectFill" data-who="partner" binderror="onAvatarError" />
              <text wx:else class="pair__initial">{{partner.initial}}</text>
            </view>
          </view>

          <block wx:if="{{scene === 'hero'}}">
            <together-clock since="{{since}}" />
            <text class="hero__since">{{sinceText}}</text>
          </block>
          <block wx:else>
            <text class="hero__since hero__since--open">还差纪念日这一笔：选下你们认定的那一天、那一刻，两个人会共用同一个起点。</text>
            <view class="mo-btn hero__btn" bind:tap="onOpenPartnerHub" aria-role="button">
              <text>去设置纪念日</text>
            </view>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
