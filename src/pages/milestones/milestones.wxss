.guide__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.guide__btn {
  margin-top: 40rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 8rpx 88rpx;
}

.pair {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.pair__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l1-card);
}

.pair__avatar--overlap {
  margin-left: -20rpx;
}

.pair__img {
  width: 100%;
  height: 100%;
}

.pair__initial {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.hero__since {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--mo-text-secondary);
}

.hero__since--open {
  margin-top: 48rpx;
}

.hero__btn {
  margin-top: 36rpx;
  width: 100%;
}

.letters__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.letters__title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.letters__head .mo-chevron {
  margin-left: 8rpx;
}

.letters__count {
  margin-right: 0;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.letters__item {
  padding: 18rpx 0;
  border-top: var(--mo-border-field);
}

.letters__item-title {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}
