.guide__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.guide__btn {
  margin-top: 40rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 8rpx 56rpx;
}

.hero__name {
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--mo-text-secondary);
}

.pair {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.pair__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid var(--mo-l0-bg);
  background-color: var(--mo-l1-card);
}

.pair__avatar--overlap {
  margin-left: -24rpx;
}

.pair__img {
  width: 100%;
  height: 100%;
}

.pair__initial {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.hero__since {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--mo-text-secondary);
}

.hero__btn {
  margin-top: 36rpx;
  width: 100%;
}

.letters__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.letters__title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.letters__head .mo-chevron {
  margin-left: 8rpx;
}

.letters__count {
  margin-right: 0;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.letters__item {
  padding: 18rpx 0;
  border-top: var(--mo-border-field);
}

.letters__item-title {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}
