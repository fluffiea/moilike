.checking {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.checking__spinner {
  margin-right: 0;
  border-color: rgba(0, 0, 0, 0.1);
  border-top-color: var(--mo-brand-teal);
}

.checking__text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 56rpx;
}

.hero__brand {
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--mo-brand-slate);
}

.hero__tagline {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--mo-text-secondary);
}

.form {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l1-card);
  box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.08);
}

.avatar__img {
  width: 100%;
  height: 100%;
}

.avatar__plus {
  width: 48rpx;
  height: 48rpx;
}

.avatar__hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  opacity: 0;
}

.avatar__tip {
  margin: 16rpx 0 40rpx;
}

.form__field {
  width: 100%;
}
