.stage {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
}

.fill {
  flex: 1;
  height: 0;
}

.pad {
  padding: 0 var(--mo-pad-h) 32rpx;
}

.peek {
  align-self: flex-start;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

.peek--under {
  margin-top: 8rpx;
  margin-bottom: 0;
}

.preview {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.guide__btn {
  margin-top: 40rpx;
}

.head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 32rpx var(--mo-pad-h) 24rpx;
  flex-shrink: 0;
}

.head__main {
  flex: 1;
  min-width: 0;
}

.head__name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.head__link {
  margin-top: 8rpx;
  margin-left: 16rpx;
  padding: 8rpx 0 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--mo-brand-slate);
  flex-shrink: 0;
}

.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 var(--mo-pad-h) 24rpx;
  flex-shrink: 0;
}

.search__field {
  flex: 1;
  min-width: 0;
}

.search__input {
  width: 100%;
}

.search__clear {
  margin-left: 20rpx;
  padding: 8rpx 0;
  flex-shrink: 0;
}

.search__clear-text {
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

.board {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: row;
  padding-left: var(--mo-pad-h);
}

.rail {
  width: 128rpx;
  height: 100%;
  flex-shrink: 0;
}

.rail--dim {
  opacity: 0.4;
}

.rail__item {
  margin-bottom: 12rpx;
  padding: 20rpx 8rpx;
  border-radius: var(--mo-radius-inner);
  text-align: center;
}

.rail__item--on {
  background-color: var(--mo-l1-card);
}

.rail__name {
  display: block;
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
  color: var(--mo-text-secondary);
}

.rail__item--on .rail__name {
  font-weight: 600;
  color: var(--mo-text-primary);
}

.rail-end {
  height: 24rpx;
}

.list {
  flex: 1;
  height: 100%;
  min-width: 0;
}

.list-end {
  height: 32rpx;
}

.sec {
  margin-right: var(--mo-pad-h);
  margin-bottom: 28rpx;
  margin-left: 12rpx;
}

.sec__card {
  margin-bottom: 0;
  padding: 8rpx 24rpx;
}

.hits {
  margin: 0 var(--mo-pad-h) 0 12rpx;
  padding: 8rpx 24rpx;
}

.dish {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.dish--line {
  border-top: var(--mo-border-field);
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  margin-right: 16rpx;
  border-radius: var(--mo-radius-inner);
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.thumb--sm {
  width: 72rpx;
  height: 72rpx;
}

.thumb__img {
  width: 100%;
  height: 100%;
}

.thumb__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.thumb__txt {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.dish__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish__name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--mo-text-secondary);
}

.tag {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--mo-radius-chip);
  background-color: var(--mo-l0-bg);
}

.tag__txt {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.plus__icon {
  width: 32rpx;
  height: 32rpx;
}

.dock {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.dock--in {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: var(--mo-border-field);
}

.dock__count {
  flex: 1;
  min-width: 0;
}

.dock__count-text {
  font-size: 32rpx;
  color: var(--mo-text-primary);
}

.dock__btn {
  width: 200rpx;
}

.dock__go {
  width: 280rpx;
}

.line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.line__danger {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--mo-text-danger);
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.cart-list {
  max-height: 520rpx;
}

.cart-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
}

.cart-row--line {
  border-top: var(--mo-border-field);
}
