.stage {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
}

.fill {
  flex: 1;
  height: 0;
}

.pad {
  padding: 0 var(--mo-pad-h) 32rpx;
}

.side {
  margin-bottom: 28rpx;
}

.side .mo-chip {
  margin-bottom: 0;
}

.guide__btn {
  margin-top: 40rpx;
}

.head {
  margin: 8rpx var(--mo-pad-h) 24rpx;
  flex-shrink: 0;
}

.head__row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.head__name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.head__link {
  margin-left: 16rpx;
  padding: 12rpx 0 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--mo-brand-slate);
  flex-shrink: 0;
}

.head__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.cats {
  flex-shrink: 0;
}

.cats__in {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 0 20rpx var(--mo-pad-h);
}

.cats__chip {
  margin: 0 12rpx 0 0;
  flex-shrink: 0;
}

.cats__end {
  width: calc(var(--mo-pad-h) - 12rpx);
  height: 8rpx;
  flex-shrink: 0;
}

.list {
  flex: 1;
  height: 0;
}

.list__in {
  padding: 0 var(--mo-pad-h) 32rpx;
}

.sec {
  padding: 8rpx 32rpx;
}

.sec__name {
  display: block;
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.sec__empty {
  display: block;
  padding: 8rpx 0 24rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.dish {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.dish--line {
  border-top: var(--mo-border-field);
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  margin-right: 20rpx;
  border-radius: var(--mo-radius-inner);
  overflow: hidden;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.thumb--cart {
  width: 112rpx;
  height: 112rpx;
}

.thumb__img {
  width: 100%;
  height: 100%;
}

.thumb__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.thumb__initial {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--mo-text-secondary);
}

.dish__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish__name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

.tag {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--mo-radius-chip);
  background-color: var(--mo-l0-bg);
}

.tag__txt {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.dish__step {
  margin-left: 12rpx;
}

.plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background-color: var(--mo-fill-brand);
  flex-shrink: 0;
}

.plus__icon {
  width: 32rpx;
  height: 32rpx;
}

.dock {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.dock__info {
  flex: 1;
  min-width: 0;
}

.dock__label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.dock__count {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.dock__btn {
  width: 240rpx;
}

.line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.line__main {
  flex: 1;
  min-width: 0;
}

.line__danger {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--mo-text-danger);
}

.sheet__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.sheet__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.sheet__go {
  margin-top: 24rpx;
}

.cart-list {
  max-height: 560rpx;
}

.cart-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.cart-row__qty {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.cart-row--line {
  border-top: var(--mo-border-field);
}
