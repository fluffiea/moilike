<view class="mo-page">
  <app-nav title="点单" large="{{true}}" />

  <scroll-view
    wx:if="{{scene === 'loading' || scene === 'error' || scene === 'unpaired' || scene === 'no_kitchen'}}"
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="mo-body">
      <state-view wx:if="{{scene === 'loading'}}" status="loading" rows="{{2}}" />
      <state-view wx:elif="{{scene === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRefresh" />
      <view wx:elif="{{scene === 'unpaired'}}" class="mo-card blank">
        <text class="blank__title">先结伴才能点单</text>
        <text class="mo-hint blank__hint">点单看的是对方的小厨房</text>
        <text class="mo-hint blank__hint">结伴后，就能来点 Ta 的心意</text>
      </view>
      <view wx:else class="mo-card blank">
        <text class="blank__title">Ta 还没有开厨房</text>
        <text class="mo-hint blank__hint">点单需要对方先建好小厨房</text>
        <text class="mo-hint blank__hint">催催对方去「独白 → 我的厨房」创建吧</text>
      </view>
    </view>
  </scroll-view>

  <view wx:else class="stage">
    <view class="mo-card head">
      <view class="head__main">
        <text class="head__name">{{kitchenName}}</text>
        <text class="mo-hint head__sub">Ta 的心意菜单</text>
      </view>
      <text class="head__link" bind:tap="onOrders" aria-role="button">我的订单</text>
    </view>

    <scroll-view
      wx:if="{{scene === 'empty'}}"
      class="fill"
      scroll-y
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
    >
      <view class="pad">
        <view class="mo-card blank">
          <text class="blank__title">厨房还是空的</text>
          <text class="mo-hint blank__hint">对方还没添加分类和菜品</text>
          <text class="mo-hint blank__hint">等 Ta 在独白里把菜单建好再来点</text>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="board">
      <scroll-view class="rail" scroll-y show-scrollbar="{{false}}">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="rail__item {{item.on ? 'rail__item--on' : ''}}"
          data-id="{{item.id}}"
          bind:tap="onPickCat"
          aria-role="button"
        >
          <text wx:for="{{item.chars}}" wx:for-item="ch" wx:key="index" class="rail__ch">{{ch}}</text>
        </view>
      </scroll-view>
      <scroll-view
        class="list"
        scroll-y
        show-scrollbar="{{false}}"
        refresher-enabled
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
      >
        <view wx:if="{{catEmpty}}" class="cat-empty">
          <text class="cat-empty__title">这个分类还没有心意</text>
        </view>
        <view wx:for="{{dishes}}" wx:key="id" class="mo-card dish">
          <view class="thumb">
            <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="thumb__ph"><text class="thumb__txt">暂无封面</text></view>
          </view>
          <view class="dish__main">
            <text class="dish__name">{{item.name}}</text>
            <text wx:if="{{item.desc}}" class="dish__desc">{{item.desc}}</text>
            <view wx:if="{{item.cat || item.sales}}" class="meta">
              <text wx:if="{{item.cat}}" class="tag">{{item.cat}}</text>
              <text wx:if="{{item.sales}}" class="tag">{{item.sales}}</text>
            </view>
          </view>
          <view class="plus" data-id="{{item.id}}" bind:tap="onOpenSpec" aria-role="button" aria-label="加入">
            <image class="plus__icon" src="/images/icons/plus.png" mode="aspectFit" />
          </view>
        </view>
        <view class="list-end" />
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{cartPortions && !cartOpen && !specOpen}}" class="mo-footer dock">
    <text class="dock__count">共 {{cartPortions}} 份</text>
    <view class="mo-btn mo-btn--small dock__btn" bind:tap="onOpenCart" aria-role="button">
      <text>去下单</text>
    </view>
  </view>

  <view wx:if="{{specOpen}}" class="mask" bind:tap="onCloseSpec">
    <view class="sheet" catch:tap="noop">
      <view class="handle" />
      <view class="spec">
        <view class="thumb thumb--lg">
          <image wx:if="{{spec.cover}}" class="thumb__img" src="{{spec.cover}}" mode="aspectFill" />
          <view wx:else class="thumb__ph"><text class="thumb__txt">暂无封面</text></view>
        </view>
        <view class="spec__main">
          <text class="dish__name">{{spec.name}}</text>
          <text wx:if="{{spec.desc}}" class="dish__desc">{{spec.desc}}</text>
        </view>
      </view>
      <view class="line">
        <text class="line__label">份量</text>
        <view class="step">
          <view class="step__btn" data-dir="-1" bind:tap="onSpecStep" aria-role="button"><text class="step__mark">－</text></view>
          <text class="step__num">{{spec.quantity}}</text>
          <view class="step__btn" data-dir="1" bind:tap="onSpecStep" aria-role="button"><text class="step__mark">＋</text></view>
        </view>
      </view>
      <text class="line__label line__label--block">快捷标签</text>
      <view class="mo-chips">
        <view
          wx:for="{{spec.tags}}"
          wx:key="name"
          class="mo-chip {{item.on ? 'mo-chip--on' : ''}}"
          data-name="{{item.name}}"
          bind:tap="onToggleTag"
          aria-role="button"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="mo-btn sheet__btn" bind:tap="onAddSpec" aria-role="button"><text>加入购物车</text></view>
    </view>
  </view>

  <view wx:if="{{cartOpen}}" class="mask" bind:tap="onCloseCart">
    <view class="sheet" catch:tap="noop">
      <view class="handle" />
      <view class="line">
        <text class="sheet__title">购物车</text>
        <text class="head__link" bind:tap="onClearCart" aria-role="button">清空</text>
      </view>
      <scroll-view class="cart-list" scroll-y show-scrollbar="{{false}}">
        <view wx:for="{{cartLines}}" wx:key="key" class="cart-row">
          <view class="thumb thumb--sm">
            <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="thumb__ph"><text class="thumb__txt">暂无</text></view>
          </view>
          <view class="dish__main">
            <text class="dish__name">{{item.name}}</text>
            <text wx:if="{{item.tagText}}" class="dish__desc">{{item.tagText}}</text>
          </view>
          <view class="step">
            <view class="step__btn" data-key="{{item.key}}" data-dir="-1" bind:tap="onCartStep" aria-role="button"><text class="step__mark">－</text></view>
            <text class="step__num">{{item.quantity}}</text>
            <view class="step__btn" data-key="{{item.key}}" data-dir="1" bind:tap="onCartStep" aria-role="button"><text class="step__mark">＋</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="dock dock--in">
        <text class="dock__count">共 {{cartPortions}} 份</text>
        <view class="mo-btn dock__go" bind:tap="onCheckout" aria-role="button"><text>去下单</text></view>
      </view>
    </view>
  </view>
</view>
