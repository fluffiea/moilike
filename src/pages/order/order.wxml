<view class="mo-page">
  <app-nav title="点单" large="{{true}}" />

  <scroll-view
    wx:if="{{scene === 'loading' || scene === 'error' || scene === 'unpaired' || scene === 'no_kitchen'}}"
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="mo-body">
      <view wx:if="{{scene !== 'loading'}}" class="peek" bind:tap="onToggleMine" aria-role="button">
        <text>{{mine ? '回到 Ta 的厨房' : '看看自己的厨房'}}</text>
      </view>
      <state-view wx:if="{{scene === 'loading'}}" status="loading" rows="{{2}}" />
      <state-view wx:elif="{{scene === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRefresh" />
      <view wx:elif="{{scene === 'unpaired'}}" class="mo-card mo-guide">
        <text class="mo-guide__title">先结伴才能点单</text>
        <text class="mo-hint mo-guide__hint">点单看的是对方的小厨房</text>
        <text class="mo-hint mo-guide__hint">结伴后，就能来点 Ta 的心意</text>
      </view>
      <view wx:elif="{{mine}}" class="mo-card mo-guide">
        <text class="mo-guide__title">还没有自己的厨房</text>
        <text class="mo-hint mo-guide__hint">去「独白 → 我的厨房」创建</text>
        <text class="mo-hint mo-guide__hint">创建后就能在这里看下单页的效果</text>
      </view>
      <view wx:else class="mo-card mo-guide">
        <text class="mo-guide__title">Ta 还没有开厨房</text>
        <text class="mo-hint mo-guide__hint">点单需要对方先建好小厨房</text>
        <text class="mo-hint mo-guide__hint">催催对方去「独白 → 我的厨房」创建吧</text>
      </view>
    </view>
  </scroll-view>

  <view wx:else class="stage">
    <view class="head">
      <view class="head__main">
        <text class="head__name" overflow="ellipsis" max-lines="1">{{kitchenName}}</text>
        <view class="peek peek--under" bind:tap="onToggleMine" aria-role="button">
          <text>{{mine ? '回到 Ta 的厨房' : '看看自己的厨房'}}</text>
        </view>
      </view>
      <view class="head__link" bind:tap="onOrders" aria-role="button">
        <text>我的订单</text>
      </view>
    </view>

    <scroll-view
      wx:if="{{scene === 'empty'}}"
      class="fill"
      scroll-y
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
    >
      <view class="pad">
        <view class="mo-card mo-guide">
          <text class="mo-guide__title">厨房还是空的</text>
          <block wx:if="{{mine}}">
            <text class="mo-hint mo-guide__hint">还没有上架的菜</text>
            <text class="mo-hint mo-guide__hint">去独白里的「我的厨房」添加后再来看</text>
          </block>
          <block wx:else>
            <text class="mo-hint mo-guide__hint">对方还没添加分类和菜品</text>
            <text class="mo-hint mo-guide__hint">等 Ta 在独白里把菜单建好再来点</text>
          </block>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="board">
      <scroll-view class="rail" scroll-y show-scrollbar="{{false}}">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="rail__item {{item.on ? 'rail__item--on' : ''}}"
          data-id="{{item.id}}"
          bind:tap="onPickCat"
          aria-role="button"
        >
          <text class="rail__name" overflow="ellipsis" max-lines="2">{{item.name}}</text>
        </view>
        <view class="rail-end" />
      </scroll-view>
      <scroll-view
        class="list"
        scroll-y
        show-scrollbar="{{false}}"
        refresher-enabled
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
      >
        <state-view wx:if="{{catEmpty}}" status="empty" title="这个分类还没有心意" />
        <view wx:else class="mo-card menu">
          <view wx:for="{{dishes}}" wx:key="id" class="dish {{index ? 'dish--line' : ''}}">
            <view class="thumb">
              <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
              <view wx:else class="thumb__ph"><text class="thumb__txt">暂无封面</text></view>
            </view>
            <view class="dish__main">
              <text class="dish__name">{{item.name}}</text>
              <text wx:if="{{item.desc}}" class="sub">{{item.desc}}</text>
              <view wx:if="{{item.sales}}" class="tag"><text class="tag__txt">{{item.sales}}</text></view>
            </view>
            <view class="plus" data-id="{{item.id}}" bind:tap="onOpenSpec" aria-role="button" aria-label="加入">
              <image class="plus__icon" src="/images/icons/plus.png" mode="aspectFit" />
            </view>
          </view>
        </view>
        <view class="list-end" />
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{cartPortions && !cartOpen && !specOpen}}" class="mo-footer dock">
    <text class="dock__count">共 {{cartPortions}} 份</text>
    <view class="mo-btn mo-btn--small dock__btn" bind:tap="onOpenCart" aria-role="button">
      <text>去下单</text>
    </view>
  </view>

  <view wx:if="{{specOpen}}" class="mo-mask" bind:tap="onCloseSpec">
    <view class="mo-sheet" catch:tap="noop">
      <view class="mo-sheet__handle" />
      <view class="spec">
        <view class="thumb thumb--lg">
          <image wx:if="{{spec.cover}}" class="thumb__img" src="{{spec.cover}}" mode="aspectFill" />
          <view wx:else class="thumb__ph"><text class="thumb__txt">暂无封面</text></view>
        </view>
        <view class="spec__main">
          <text class="dish__name">{{spec.name}}</text>
          <text wx:if="{{spec.desc}}" class="sub">{{spec.desc}}</text>
        </view>
      </view>
      <view class="line">
        <text class="line__label">份量</text>
        <view class="mo-step">
          <view class="mo-step__btn" data-dir="-1" bind:tap="onSpecStep" aria-role="button"><text class="mo-step__mark">－</text></view>
          <text class="mo-step__num">{{spec.quantity}}</text>
          <view class="mo-step__btn" data-dir="1" bind:tap="onSpecStep" aria-role="button"><text class="mo-step__mark">＋</text></view>
        </view>
      </view>
      <text class="line__label line__label--block">快捷标签</text>
      <view class="mo-chips">
        <view
          wx:for="{{spec.tags}}"
          wx:key="name"
          class="mo-chip {{item.on ? 'mo-chip--on' : ''}}"
          data-name="{{item.name}}"
          bind:tap="onToggleTag"
          aria-role="button"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="mo-btn sheet__btn" bind:tap="onAddSpec" aria-role="button"><text>加入购物车</text></view>
    </view>
  </view>

  <view wx:if="{{cartOpen}}" class="mo-mask" bind:tap="onCloseCart">
    <view class="mo-sheet" catch:tap="noop">
      <view class="mo-sheet__handle" />
      <view class="line">
        <text class="sheet__title">购物车</text>
        <view class="line__danger" bind:tap="onClearCart" aria-role="button">
          <text>清空</text>
        </view>
      </view>
      <scroll-view class="cart-list" scroll-y show-scrollbar="{{false}}">
        <view wx:for="{{cartLines}}" wx:key="key" class="cart-row {{index ? 'cart-row--line' : ''}}">
          <view class="thumb thumb--sm">
            <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="thumb__ph"><text class="thumb__txt">暂无</text></view>
          </view>
          <view class="dish__main">
            <text class="dish__name">{{item.name}}</text>
            <text wx:if="{{item.tagText}}" class="sub">{{item.tagText}}</text>
          </view>
          <view class="mo-step">
            <view class="mo-step__btn" data-key="{{item.key}}" data-dir="-1" bind:tap="onCartStep" aria-role="button"><text class="mo-step__mark">－</text></view>
            <text class="mo-step__num">{{item.quantity}}</text>
            <view class="mo-step__btn" data-key="{{item.key}}" data-dir="1" bind:tap="onCartStep" aria-role="button"><text class="mo-step__mark">＋</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="dock dock--in">
        <text class="dock__count">共 {{cartPortions}} 份</text>
        <view class="mo-btn dock__go" bind:tap="onCheckout" aria-role="button"><text>去下单</text></view>
      </view>
    </view>
  </view>
</view>
