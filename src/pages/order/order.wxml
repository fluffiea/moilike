<view class="mo-page">
  <app-nav title="点单" large="{{true}}" />

  <scroll-view
    wx:if="{{scene === 'loading' || scene === 'error' || scene === 'unpaired' || scene === 'no_kitchen'}}"
    class="mo-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="mo-body">
      <view wx:if="{{scene !== 'loading'}}" class="peek" bind:tap="onToggleMine" aria-role="button">
        <text>{{mine ? '回到 Ta 的厨房' : '看看自己的厨房'}}</text>
      </view>
      <state-view wx:if="{{scene === 'loading'}}" status="loading" rows="{{2}}" />
      <state-view wx:elif="{{scene === 'error'}}" status="error" hint="{{errorText}}" action="重试" bind:action="onRefresh" />
      <view wx:elif="{{scene === 'unpaired'}}" class="mo-card mo-guide">
        <text class="mo-guide__title">先结伴才能点单</text>
        <text class="mo-hint mo-guide__hint">点单看的是对方的小厨房</text>
        <view class="mo-btn guide__btn" bind:tap="onPartner" aria-role="button">
          <text>去结伴</text>
        </view>
      </view>
      <view wx:elif="{{mine}}" class="mo-card mo-guide">
        <text class="mo-guide__title">还没有自己的厨房</text>
        <text class="mo-hint mo-guide__hint">去独白里的「我的厨房」创建</text>
      </view>
      <view wx:else class="mo-card mo-guide">
        <text class="mo-guide__title">Ta 还没有开厨房</text>
        <text class="mo-hint mo-guide__hint">催催对方去「独白 → 我的厨房」创建吧</text>
      </view>
    </view>
  </scroll-view>

  <view wx:else class="stage">
    <view class="head">
      <view class="head__main">
        <text class="head__name" overflow="ellipsis" max-lines="1">{{kitchenName}}</text>
        <view class="peek peek--under" bind:tap="onToggleMine" aria-role="button">
          <text>{{mine ? '回到 Ta 的厨房' : '看看自己的厨房'}}</text>
        </view>
        <text wx:if="{{mine}}" class="preview">预览自己的厨房 · 不能下单</text>
      </view>
      <view class="head__link" bind:tap="onOrders" aria-role="button">
        <text>我的订单</text>
      </view>
    </view>

    <view wx:if="{{scene === 'menu'}}" class="search">
      <view class="mo-field search__field">
        <input
          class="mo-input search__input"
          value="{{keyword}}"
          placeholder="搜菜名"
          placeholder-class="mo-placeholder"
          confirm-type="search"
          bindinput="onSearch"
        />
      </view>
      <view wx:if="{{keyword}}" class="search__clear" bind:tap="onClearSearch" aria-role="button">
        <text class="search__clear-text">清空</text>
      </view>
    </view>

    <scroll-view
      wx:if="{{scene === 'empty'}}"
      class="fill"
      scroll-y
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
    >
      <view class="pad">
        <view class="mo-card mo-guide">
          <text class="mo-guide__title">厨房还是空的</text>
          <block wx:if="{{mine}}">
            <text class="mo-hint mo-guide__hint">去独白里的「我的厨房」添加后再来看</text>
            <view class="mo-btn guide__btn" bind:tap="onManageMenu" aria-role="button">
              <text>去管理菜单</text>
            </view>
          </block>
          <text wx:else class="mo-hint mo-guide__hint">等 Ta 在独白里把菜单建好再来点</text>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="board">
      <scroll-view wx:if="{{!searching}}" class="rail" scroll-y show-scrollbar="{{false}}" scroll-into-view="{{railInto}}" scroll-with-animation>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          id="rail-{{index}}"
          class="rail__item {{item.on ? 'rail__item--on' : ''}}"
          data-id="{{item.id}}"
          bind:tap="onPickCat"
          aria-role="tab"
        >
          <text class="rail__name">{{item.name}}</text>
        </view>
        <view class="rail-end" />
      </scroll-view>

      <scroll-view
        wx:if="{{searching}}"
        class="list"
        scroll-y
        show-scrollbar="{{false}}"
        refresher-enabled
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
      >
        <state-view
          wx:if="{{searchEmpty}}"
          status="empty"
          title="没有找到相关菜"
          hint="换个关键词试试"
          action="清空搜索"
          bind:action="onClearSearch"
        />
        <view wx:else class="hits">
          <view wx:for="{{searchHits}}" wx:key="id" class="dish {{index ? 'dish--line' : ''}}">
            <view class="thumb">
              <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
              <view wx:else class="thumb__ph"><text class="thumb__initial">{{item.initial}}</text></view>
            </view>
            <view class="dish__main">
              <text class="dish__name">{{item.name}}</text>
              <text wx:if="{{item.desc}}" class="sub">{{item.desc}}</text>
              <view wx:if="{{item.sales}}" class="tag"><text class="tag__txt">{{item.sales}}</text></view>
            </view>
            <view class="plus" data-id="{{item.id}}" bind:tap="onAdd" aria-role="button" aria-label="加入">
              <image class="plus__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
            </view>
          </view>
        </view>
        <view class="list-end" />
      </scroll-view>

      <scroll-view
        wx:else
        class="list"
        scroll-y
        show-scrollbar="{{false}}"
        scroll-into-view="{{scrollInto}}"
        scroll-with-animation
        refresher-enabled
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
        bindscroll="onListScroll"
      >
        <view wx:for="{{sections}}" wx:key="id" id="sec-{{index}}" class="sec" data-id="{{item.id}}">
          <text class="sec__name">{{item.name}}</text>
          <text wx:if="{{item.empty}}" class="sec__empty">这个分类还没有心意</text>
          <view wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="id" class="dish {{index ? 'dish--line' : ''}}">
            <view class="thumb">
              <image wx:if="{{dish.cover}}" class="thumb__img" src="{{dish.cover}}" mode="aspectFill" />
              <view wx:else class="thumb__ph"><text class="thumb__initial">{{dish.initial}}</text></view>
            </view>
            <view class="dish__main">
              <text class="dish__name">{{dish.name}}</text>
              <text wx:if="{{dish.desc}}" class="sub">{{dish.desc}}</text>
              <view wx:if="{{dish.sales}}" class="tag"><text class="tag__txt">{{dish.sales}}</text></view>
            </view>
            <view class="plus" data-id="{{dish.id}}" bind:tap="onAdd" aria-role="button" aria-label="加入">
              <image class="plus__icon" src="/images/icons/plus-light.png" mode="aspectFit" />
            </view>
          </view>
        </view>
        <view class="list-end" />
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{cartPortions && !cartOpen}}" class="mo-footer dock">
    <view class="dock__bag" bind:tap="onOpenCart" aria-role="button" aria-label="购物车">
      <text class="dock__bag-num">{{cartPortions}}</text>
    </view>
    <view class="dock__count" bind:tap="onOpenCart" aria-role="button">
      <text class="dock__label">购物车</text>
      <text class="dock__count-text">共 {{cartPortions}} 份</text>
    </view>
    <view class="mo-btn dock__btn" bind:tap="onOpenCart" aria-role="button">
      <text>去下单</text>
    </view>
  </view>

  <view wx:if="{{cartOpen}}" class="mo-mask" bind:tap="onCloseCart">
    <view class="mo-sheet" catch:tap="noop">
      <view class="mo-sheet__handle" />
      <view class="line">
        <view class="line__main">
          <text class="sheet__title">购物车</text>
          <text class="sheet__meta">共 {{cartPortions}} 份</text>
        </view>
        <view class="line__danger" bind:tap="onClearCart" aria-role="button">
          <text>清空</text>
        </view>
      </view>
      <scroll-view class="cart-list" scroll-y show-scrollbar="{{false}}">
        <view wx:for="{{cartLines}}" wx:key="key" class="cart-row {{index ? 'cart-row--line' : ''}}">
          <view class="thumb thumb--cart">
            <image wx:if="{{item.cover}}" class="thumb__img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="thumb__ph"><text class="thumb__initial">{{item.initial}}</text></view>
          </view>
          <view class="dish__main">
            <text class="dish__name">{{item.name}}</text>
            <text class="cart-row__qty">{{item.quantity}} 份</text>
          </view>
          <view class="mo-step">
            <view class="mo-step__btn" data-key="{{item.key}}" data-dir="-1" bind:tap="onCartStep" aria-role="button"><text class="mo-step__mark">－</text></view>
            <text class="mo-step__num">{{item.quantity}}</text>
            <view class="mo-step__btn" data-key="{{item.key}}" data-dir="1" bind:tap="onCartStep" aria-role="button"><text class="mo-step__mark">＋</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="mo-btn sheet__go" bind:tap="onCheckout" aria-role="button"><text>去下单</text></view>
    </view>
  </view>
</view>
