{
  "cloud": true,
  "pages": [
    "pages/milestones/milestones",
    "pages/letters/letters",
    "pages/resonance/resonance",
    "pages/profile/profile",
    "pages/login/login"
  ],
  "window": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f2f2f7"
  },
  "usingComponents": {
    "app-nav": "/components/app-nav/app-nav"
  },
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "tagNameStyleIsolation": "legacy",
      "enableScrollViewAutoSize": true,
      "keyframeStyleIsolation": "legacy",
      "disableABTest": true,
      "sdkVersionBegin": "3.0.2",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "tabBar": {
    "color": "#8E8E93",
    "selectedColor": "#668F80",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/milestones/milestones",
        "text": "朝夕",
        "iconPath": "images/tabbar/milestones.png",
        "selectedIconPath": "images/tabbar/milestones-active.png"
      },
      {
        "pagePath": "pages/letters/letters",
        "text": "素笺",
        "iconPath": "images/tabbar/letters.png",
        "selectedIconPath": "images/tabbar/letters-active.png"
      },
      {
        "pagePath": "pages/resonance/resonance",
        "text": "共鸣",
        "iconPath": "images/tabbar/resonance.png",
        "selectedIconPath": "images/tabbar/resonance-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "独白",
        "iconPath": "images/tabbar/profile.png",
        "selectedIconPath": "images/tabbar/profile-active.png"
      }
    ]
  },
  "subpackages": [
    {
      "root": "subpackages/user",
      "name": "user",
      "pages": ["edit-profile/edit-profile", "preferences/preferences", "partner-hub/partner-hub"]
    },
    {
      "root": "subpackages/resonance",
      "name": "resonance_pack",
      "pages": ["report-compose/report-compose", "report-detail/report-detail"]
    },
    {
      "root": "subpackages/letters",
      "name": "letters_pack",
      "pages": ["letter-compose/letter-compose", "letter-detail/letter-detail"]
    },
    {
      "root": "subpackages/ledger",
      "name": "ledger",
      "pages": ["home/home", "compose/compose", "detail/detail", "category/category"]
    }
  ],
  "preloadRule": {
    "pages/milestones/milestones": { "network": "all", "packages": ["user"] },
    "pages/letters/letters": { "network": "all", "packages": ["letters_pack"] },
    "pages/resonance/resonance": { "network": "all", "packages": ["resonance_pack"] },
    "pages/profile/profile": { "network": "all", "packages": ["user", "ledger"] }
  }
}
