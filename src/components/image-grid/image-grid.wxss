.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.grid__cell {
  position: relative;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
}

.grid__img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.grid--one .grid__cell {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: var(--mo-radius-inner);
}

.grid--two .grid__cell {
  width: calc((100% - 16rpx) / 2);
  aspect-ratio: 1;
  border-radius: var(--mo-radius-inner);
}

.grid--two .grid__cell:first-child {
  margin-right: 16rpx;
}

.grid--many .grid__cell {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--mo-radius-inner);
}

.grid--many {
  margin-bottom: -16rpx;
}

.grid--many .grid__cell:nth-child(3n) {
  margin-right: 0;
}
