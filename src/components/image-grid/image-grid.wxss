.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.grid__cell {
  position: relative;
  overflow: hidden;
  background-color: var(--mo-l1-accent);
}

.grid__img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.grid--one .grid__cell {
  width: 100%;
  height: 360rpx;
  border-radius: var(--mo-radius-inner);
}

.grid--two .grid__cell {
  width: calc((100% - 12rpx) / 2);
  height: 240rpx;
  border-radius: 24rpx;
}

.grid--two .grid__cell:first-child {
  margin-right: 12rpx;
}

.grid--many .grid__cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  margin: 0 12rpx 12rpx 0;
  border-radius: 20rpx;
}

.grid--many .grid__cell:nth-child(3n) {
  margin-right: 0;
}
