.card {
  margin-bottom: 36rpx;
  padding: 32rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.card--detail {
  margin-bottom: 0;
}

.card__head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--mo-l1-accent);
  box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.06);
}

.avatar__img {
  width: 100%;
  height: 100%;
}

.avatar__initial {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
}

.card__meta {
  flex: 1;
  min-width: 0;
}

.card__name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card__time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

/* 88rpx 点击区 */
.more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: -20rpx;
}

.more__icon {
  width: 36rpx;
  height: 36rpx;
}

.card__text {
  display: block;
  margin-top: 24rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.preview {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: var(--mo-border-field);
}

.preview__line {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}

.preview__count {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}
