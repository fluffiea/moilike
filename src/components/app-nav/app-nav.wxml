<view class="nav" style="padding-top: {{top}}px;">
  <view class="nav__bar {{large ? 'nav__bar--large' : ''}}">
    <view wx:if="{{showBack}}" class="nav__back" bind:tap="onBack" aria-role="button" aria-label="返回">
      <image class="nav__icon" src="/images/icons/chevron.png" mode="aspectFit" />
    </view>
    <text class="nav__title {{large ? 'nav__title--large' : ''}}">{{title}}</text>
  </view>
</view>
