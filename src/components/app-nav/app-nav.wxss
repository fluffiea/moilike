.nav {
  flex-shrink: 0;
  background: rgba(242, 242, 247, 0.82);
  backdrop-filter: blur(24px);
}

.nav__bar {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.nav__bar--large {
  justify-content: flex-start;
  padding-left: var(--mo-pad-h);
}

/* 88rpx 点击区，避开右上角胶囊 */
.nav__back {
  position: absolute;
  left: 8rpx;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}

.nav__icon {
  width: 40rpx;
  height: 40rpx;
  transform: rotate(180deg);
}

.nav__title {
  max-width: 56%;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav__title--large {
  max-width: 70%;
  font-size: 44rpx;
  font-weight: 600;
}
