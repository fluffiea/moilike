.clock {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.clock__days {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.clock__mark {
  margin-bottom: 22rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--mo-text-secondary);
}

.clock__mark--lead {
  margin-right: 28rpx;
}

.clock__mark--tail {
  margin-left: 28rpx;
}

.clock__value {
  font-size: 128rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.clock__rest {
  margin-top: 36rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-muted);
}
