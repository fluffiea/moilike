.clock {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
}

.clock__value {
  font-size: 128rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.clock__unit {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--mo-text-secondary);
}

.clock__rest {
  margin-top: 6rpx;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-secondary);
}
