.clock {
  display: flex;
  flex-direction: row;
}

.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
  padding: 24rpx 0 20rpx;
  border-radius: 28rpx;
  background-color: var(--mo-l1-accent);
  border: var(--mo-border-card);
}

.cell--days {
  flex: 1.5;
  background: var(--mo-gradient-brand);
}

.cell--last {
  margin-right: 0;
}

.cell__value {
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--mo-text-primary);
}

.cell--days .cell__value,
.cell--days .cell__unit {
  color: var(--mo-text-inverse);
}

.cell__unit {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--mo-text-secondary);
}
