.picker {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: -16rpx;
}

.cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--mo-radius-inner);
  overflow: hidden;
  background-color: var(--mo-l0-bg);
}

.cell:nth-child(3n) {
  margin-right: 0;
}

.cell__img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 删除按钮视觉 40rpx，点击区 72rpx */
.cell__remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 72rpx;
  height: 72rpx;
}

.cell__x {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 28, 30, 0.45);
}

.cell__x-icon {
  width: 20rpx;
  height: 20rpx;
}

.cell--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add__plus {
  width: 40rpx;
  height: 40rpx;
}

.add__count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}
