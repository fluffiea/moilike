<view wx:if="{{detail}}" class="card card--detail" bind:longpress="onLongPress">
  <view class="head">
    <text class="head__who {{post.isMine ? 'head__who--mine' : ''}}">{{post.who}}</text>
    <view class="head__fill" />
    <text class="head__clock">{{post.clock}}</text>
    <view wx:if="{{post.isMine}}" class="head__more" catch:tap="onMore" aria-role="button" aria-label="编辑或删除">
      <image class="head__more-icon" src="/images/icons/more.png" mode="aspectFit" />
    </view>
  </view>

  <text class="body body--full">{{post.preview}}</text>
  <text wx:if="{{post.tagLine}}" class="tags">{{post.tagLine}}</text>
  <image-grid wx:if="{{post.images.length}}" images="{{post.images}}" />

  <view wx:if="{{post.isMine}}" class="echo">
    <image wx:if="{{post.echo.sticker}}" class="echo__art" src="{{post.echo.sticker.src}}" mode="aspectFit" />
    <text wx:if="{{post.echo.label}}" class="echo__label">{{post.echo.label}}</text>
    <text wx:if="{{post.echo.wait}}" class="echo__wait">{{post.echo.wait}}</text>
    <view class="echo__fill" />
    <text wx:if="{{post.echo.meta}}" class="echo__meta">{{post.echo.meta}}</text>
  </view>
</view>

<view wx:else class="card {{book ? 'card--book' : ''}}" bind:tap="onOpen" bind:longpress="onLongPress" aria-role="button">
  <view class="head">
    <text class="head__who {{post.isMine ? 'head__who--mine' : ''}}">{{post.who}}</text>
    <view class="head__fill" />
    <text class="head__clock">{{post.clock}}</text>
    <view wx:if="{{post.isMine && !book}}" class="head__more" catch:tap="onMore" aria-role="button" aria-label="编辑或删除">
      <image class="head__more-icon" src="/images/icons/more.png" mode="aspectFit" />
    </view>
  </view>

  <text class="body" overflow="ellipsis" max-lines="4">{{post.preview}}</text>
  <text wx:if="{{post.tagLine}}" class="tags">{{post.tagLine}}</text>
  <image wx:if="{{post.cover}}" class="cover" src="{{post.cover}}" mode="aspectFill" />
  <text wx:if="{{post.moreShots}}" class="shots">{{post.moreShots}}</text>

  <view class="echo">
    <image wx:if="{{post.echo.sticker}}" class="echo__art" src="{{post.echo.sticker.src}}" mode="aspectFit" />
    <text wx:if="{{post.echo.label}}" class="echo__label">{{post.echo.label}}</text>
    <text wx:if="{{post.echo.wait}}" class="echo__wait">{{post.echo.wait}}</text>
    <view class="echo__fill" />
    <text wx:if="{{post.echo.meta}}" class="echo__meta">{{post.echo.meta}}</text>
    <view wx:if="{{post.echo.action}}" class="echo__action" catch:tap="onQuick" aria-role="button" aria-label="回心">
      <text class="echo__action-text">回心</text>
    </view>
  </view>
</view>
