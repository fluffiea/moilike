<view wx:if="{{detail}}" class="card card--detail" bind:longpress="onLongPress">
  <view class="sheet">
    <view class="byline">
      <image
        wx:if="{{post.author.avatarUrl && !avatarError}}"
        class="byline__ava"
        src="{{post.author.avatarUrl}}"
        mode="aspectFill"
        binderror="onAvatarError"
      />
      <view wx:else class="byline__ava byline__ava--empty">
        <text class="byline__initial">{{post.authorInitial}}</text>
      </view>
      <text class="byline__name" overflow="ellipsis" max-lines="1">{{post.authorName}}</text>
      <view wx:if="{{post.tagChips.length}}" class="byline__tags">
        <view wx:for="{{post.tagChips}}" wx:key="*this" class="byline__tag">
          <text class="byline__tag-text" overflow="ellipsis" max-lines="1">{{item}}</text>
        </view>
        <text wx:if="{{post.tagMore}}" class="byline__tag-more">{{post.tagMore}}</text>
      </view>
      <view class="byline__fill" />
      <text class="byline__time">{{post.clock}}</text>
      <view wx:if="{{post.isMine}}" class="byline__more" catch:tap="onMore" aria-role="button" aria-label="编辑或删除">
        <image class="byline__more-icon" src="/images/icons/more.png" mode="aspectFit" />
      </view>
    </view>

    <text wx:if="{{post.preview}}" class="body body--full">{{post.preview}}</text>
    <image-grid wx:if="{{post.images.length}}" images="{{post.images}}" />

    <view wx:if="{{post.isMine}}" class="echo">
      <image wx:if="{{post.echo.sticker}}" class="echo__art" src="{{post.echo.sticker.src}}" mode="aspectFit" />
      <text wx:if="{{post.echo.label}}" class="echo__label">{{post.echo.label}}</text>
      <text wx:if="{{post.echo.wait}}" class="echo__wait">{{post.echo.wait}}</text>
      <view class="echo__fill" />
      <text wx:if="{{post.echo.meta}}" class="echo__meta">{{post.echo.meta}}</text>
    </view>
  </view>
</view>

<view wx:else class="card {{book ? 'card--book' : ''}}" bind:tap="onOpen" bind:longpress="onLongPress" aria-role="button">
  <view class="sheet">
    <view wx:if="{{shots.length}}" class="album album--{{album}}">
      <view wx:for="{{shots}}" wx:key="id" class="album__cell">
        <image class="album__img" src="{{item.thumb}}" mode="aspectFill" />
        <view wx:if="{{item.more}}" class="album__count">
          <text class="album__count-text">{{item.more}}</text>
        </view>
      </view>
    </view>

    <view class="byline">
      <image
        wx:if="{{post.author.avatarUrl && !avatarError}}"
        class="byline__ava"
        src="{{post.author.avatarUrl}}"
        mode="aspectFill"
        binderror="onAvatarError"
      />
      <view wx:else class="byline__ava byline__ava--empty">
        <text class="byline__initial">{{post.authorInitial}}</text>
      </view>
      <text class="byline__name" overflow="ellipsis" max-lines="1">{{post.authorName}}</text>
      <view wx:if="{{post.tagChips.length}}" class="byline__tags">
        <view wx:for="{{post.tagChips}}" wx:key="*this" class="byline__tag">
          <text class="byline__tag-text" overflow="ellipsis" max-lines="1">{{item}}</text>
        </view>
        <text wx:if="{{post.tagMore}}" class="byline__tag-more">{{post.tagMore}}</text>
      </view>
      <view class="byline__fill" />
      <text class="byline__time">{{post.clock}}</text>
      <view wx:if="{{post.isMine && !book}}" class="byline__more" catch:tap="onMore" aria-role="button" aria-label="编辑或删除">
        <image class="byline__more-icon" src="/images/icons/more.png" mode="aspectFit" />
      </view>
    </view>

    <text wx:if="{{post.preview}}" class="body" overflow="ellipsis" max-lines="3">{{post.preview}}</text>

    <view class="echo">
      <image wx:if="{{post.echo.sticker}}" class="echo__art" src="{{post.echo.sticker.src}}" mode="aspectFit" />
      <text wx:if="{{post.echo.label}}" class="echo__label">{{post.echo.label}}</text>
      <text wx:if="{{post.echo.wait}}" class="echo__wait">{{post.echo.wait}}</text>
      <view class="echo__fill" />
      <text wx:if="{{post.echo.meta}}" class="echo__meta">{{post.echo.meta}}</text>
      <view wx:if="{{post.echo.action}}" class="echo__action" catch:tap="onQuick" aria-role="button" aria-label="回声">
        <text class="echo__action-text">回声</text>
      </view>
    </view>
  </view>
</view>
