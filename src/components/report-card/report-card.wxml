<view class="card {{detail ? 'card--detail' : 'card--list'}} {{post.isMine ? 'card--mine' : ''}}" bind:tap="onOpen" bind:longpress="onMore">
  <view wx:if="{{!detail || post.isMine}}" class="card__meta">
    <text wx:if="{{!detail}}" class="card__state card__state--{{post.stateKey}}">{{post.stateLabel}}</text>
    <text wx:if="{{!detail}}" class="card__clock">{{post.time}}</text>
    <view wx:if="{{post.isMine}}" class="more" catch:tap="onMore" aria-role="button" aria-label="编辑或删除">
      <image class="more__icon" src="/images/icons/more.png" mode="aspectFit" />
    </view>
  </view>

  <text class="card__name">{{post.headline}}</text>

  <block wx:if="{{detail}}">
    <text class="card__state card__state--{{post.stateKey}} card__state--block">{{post.stateLabel}}</text>
    <text class="card__time">{{post.time}}</text>
    <view wx:if="{{post.tags.length}}" class="tags">
      <view wx:for="{{post.tags}}" wx:key="*this" class="tag">
        <text class="tag__text">{{item}}</text>
      </view>
    </view>
    <text wx:if="{{post.rest}}" class="card__body">{{post.rest}}</text>
  </block>
  <block wx:else>
    <text wx:if="{{post.rest}}" class="card__body">{{post.rest}}</text>
    <view wx:if="{{post.tags.length}}" class="tags">
      <view wx:for="{{post.tags}}" wx:key="*this" class="tag">
        <text class="tag__text">{{item}}</text>
      </view>
    </view>
  </block>

  <image-grid images="{{post.images}}" />

  <view wx:if="{{post.sticker && !(detail && post.canRespond)}}" class="reply">
    <image class="reply__img" src="{{post.sticker.src}}" mode="aspectFit" />
    <text class="reply__label">{{post.sticker.label}}</text>
    <text class="reply__when">{{post.respondedWhen}}</text>
  </view>
  <text wx:elif="{{post.openedHint}}" class="opened">{{post.openedHint}}</text>
</view>
