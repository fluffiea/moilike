.card {
  position: relative;
  margin-bottom: 36rpx;
  padding: 32rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
  --state-color: var(--mo-status-pending);
  --state-text: var(--mo-status-pending-text);
}

.card--read {
  --state-color: var(--mo-status-read);
  --state-text: var(--mo-status-read-text);
}

.card--evaluated {
  --state-color: var(--mo-status-evaluated);
  --state-text: var(--mo-status-evaluated-text);
}

.card--detail {
  margin-bottom: 0;
}

.card__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 56rpx;
}

.card__name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card__state {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--state-text);
}

.more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx -24rpx -16rpx 0;
}

.more__icon {
  width: 36rpx;
  height: 36rpx;
}

.card__time {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag {
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background-color: var(--mo-l0-bg);
}

.tag__text {
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.card__body {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.eval {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.eval__label {
  display: block;
  font-size: 24rpx;
  color: var(--mo-status-evaluated-text);
}

.eval__text {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--mo-text-primary);
}
