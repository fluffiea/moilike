.card {
  margin-bottom: 36rpx;
  padding: 32rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.card--row {
  margin-bottom: 16rpx;
  padding: 20rpx 32rpx;
}

.card__head {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.card__head--mine .card__name {
  margin-right: 48rpx;
}

.card__name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.card--detail .card__name {
  font-size: 40rpx;
  line-height: 1.4;
}

.more {
  position: absolute;
  top: -12rpx;
  right: -16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.more__icon {
  width: 36rpx;
  height: 36rpx;
}

.card__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
}

.card__state {
  margin-right: 16rpx;
  font-size: 24rpx;
}

.card__state--awaiting {
  color: var(--mo-status-pending-text);
}

.card__state--opened {
  color: var(--mo-status-read-text);
}

.card__state--responded {
  color: var(--mo-status-evaluated-text);
}

.card__clock {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

/* 间距放在标签上沿，最后一行不再把卡片底部撑出 12rpx */
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  margin: 16rpx 12rpx 0 0;
  padding: 6rpx 20rpx;
  border-radius: var(--mo-radius-chip);
  background-color: var(--mo-l0-bg);
}

.tag__text {
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.card__body {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.reply {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

/* 贴纸是浅色插画，垫在白底上，灰底会把浅色吃掉 */
.reply__plate {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l1-card);
  flex-shrink: 0;
}

.reply__img {
  width: 64rpx;
  height: 64rpx;
}

.reply__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--mo-text-primary);
}

.reply__when {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.opened {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}

.line {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.line__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.line__title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.line__signal {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.line__chip {
  width: 48rpx;
  height: 48rpx;
}

.line__pending {
  font-size: 24rpx;
  color: var(--mo-status-pending-text);
}

.line__when,
.line__clock {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.line__when {
  margin-left: 8rpx;
}

.line__clock {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.line__reply {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  border-radius: var(--mo-radius-chip);
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.line__reply-text {
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

.line__more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.line__more-icon {
  width: 36rpx;
  height: 36rpx;
}

.line__opened {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

/* 全部栏已闭环：字色降下来，贴纸仍认得出来 */
.card--closed .line__title-text {
  color: var(--mo-text-secondary);
}

.card--closed .line__chip {
  opacity: 0.8;
}
