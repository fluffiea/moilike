.card {
  margin-bottom: 36rpx;
  padding: 32rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.head__who {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mo-brand-teal);
  flex-shrink: 0;
}

.head__who--mine {
  color: var(--mo-brand-rose-ink);
}

.head__fill {
  flex: 1;
  min-width: 16rpx;
}

.head__clock {
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.head__more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: -12rpx -12rpx -12rpx 4rpx;
  flex-shrink: 0;
}

.head__more-icon {
  width: 36rpx;
  height: 36rpx;
}

.body {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.body--full {
  margin-top: 20rpx;
  line-height: 1.7;
}

.tags {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--mo-text-muted);
}

.cover {
  display: block;
  width: 100%;
  height: 320rpx;
  margin-top: 20rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.shots {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

/* 回声槽：未回心是等待和入口，已回心是贴纸和回心的人 */
.echo {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.echo__art {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.echo__label {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.echo__wait {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.echo__fill {
  flex: 1;
  min-width: 16rpx;
}

.echo__meta {
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.echo__action {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  padding: 12rpx 0;
  flex-shrink: 0;
}

.echo__action-text {
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

/* 已共鸣档案：只读回看，贴纸是主视觉 */
.card--book .cover {
  height: 280rpx;
}

.card--book .echo {
  padding: 20rpx 24rpx;
}

.card--book .echo__art {
  width: 96rpx;
  height: 96rpx;
}

.card--book .echo__label {
  margin-left: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
