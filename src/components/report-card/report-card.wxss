.card {
  margin-bottom: 36rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
  overflow: hidden;
}

/* 整张卡都是白的。照片、文字、回声共用这一圈内边距，页面灰只出现在卡片外面 */
.sheet {
  padding: var(--mo-pad-h);
}

/* 相册嵌在白卡片上，底用页面灰，浅色照片也不会和卡片外的背景糊在一起 */
.album {
  display: flex;
  flex-direction: row;
  margin-bottom: 24rpx;
}

.album__cell {
  position: relative;
  overflow: hidden;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.album__img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.album--one .album__cell {
  width: 100%;
  height: 320rpx;
}

.album--two .album__cell {
  width: calc((100% - 16rpx) / 2);
  aspect-ratio: 1;
}

.album--two .album__cell:first-child {
  margin-right: 16rpx;
}

.album--three .album__cell {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  margin-right: 16rpx;
}

.album--three .album__cell:last-child {
  margin-right: 0;
}

.album__count {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--mo-radius-chip);
  background: var(--mo-fill-overlay);
}

.album__count-text {
  font-size: 24rpx;
  color: var(--mo-text-inverse);
}

/* 署名行：头像 + 昵称 + 标签胶囊 + 时间 */
.byline {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.byline__ava {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--mo-l0-bg);
  flex-shrink: 0;
}

.byline__ava--empty {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.byline__initial {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mo-text-secondary);
}

.byline__name {
  max-width: 192rpx;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.byline__tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 12rpx;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
}

.byline__tag {
  max-width: 120rpx;
  margin-right: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--mo-radius-chip);
  background-color: var(--mo-l0-bg);
  overflow: hidden;
  flex-shrink: 0;
}

.byline__tag-text {
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.byline__tag-more {
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.byline__fill {
  flex: 1;
  min-width: 12rpx;
}

.byline__time {
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.byline__more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: -4rpx -8rpx -4rpx 4rpx;
  flex-shrink: 0;
}

.byline__more-icon {
  width: 36rpx;
  height: 36rpx;
}

.body {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.body--full {
  margin-top: 20rpx;
  line-height: 1.7;
}

/* 回声跟正文留在同一张白卡片上，不再铺一条接近页面底的灰 */
.echo {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
}

.echo__art {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.echo__label {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--mo-text-primary);
  flex-shrink: 0;
}

.echo__wait {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
  flex-shrink: 0;
}

.echo__fill {
  flex: 1;
  min-width: 16rpx;
}

.echo__meta {
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.echo__action {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  margin-left: 8rpx;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.echo__action-text {
  font-size: 26rpx;
  color: var(--mo-brand-slate);
}

/* 已共鸣档案：只读回看，贴纸是主视觉 */
.card--book .echo__art {
  width: 96rpx;
  height: 96rpx;
}

.card--book .echo__label {
  margin-left: 16rpx;
  font-weight: 600;
}
