.card {
  margin-bottom: 36rpx;
  padding: 32rpx;
  border-radius: var(--mo-radius-card);
  background-color: var(--mo-l1-card);
}

.card__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.card__name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.card--detail .card__name {
  font-size: 40rpx;
  line-height: 1.4;
}

.more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-top: -12rpx;
  margin-right: -16rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.more__icon {
  width: 36rpx;
  height: 36rpx;
}

.card__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
}

.card__state {
  font-size: 24rpx;
}

.card__state--block {
  display: block;
  margin-top: 16rpx;
}

.card__state--awaiting {
  color: var(--mo-status-pending-text);
}

.card__state--opened {
  color: var(--mo-status-read-text);
}

.card__state--responded {
  color: var(--mo-status-evaluated-text);
}

.card__clock {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.card__time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag {
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 20rpx;
  border-radius: var(--mo-radius-chip);
  background-color: var(--mo-l0-bg);
}

.tag__text {
  font-size: 24rpx;
  color: var(--mo-text-secondary);
}

.card__body {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.reply {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--mo-radius-inner);
  background-color: var(--mo-l0-bg);
}

.reply__img {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.reply__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--mo-text-primary);
}

.reply__when {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--mo-text-muted);
  flex-shrink: 0;
}

.opened {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
}
