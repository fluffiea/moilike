{
  "cloud": true,
  "pages": [
    "pages/login/login",
    "pages/today/today",
    "pages/mine/mine"
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "moilike",
    "navigationBarBackgroundColor": "#F6F2EC",
    "navigationStyle": "custom",
    "backgroundColor": "#F6F2EC"
  },
  "renderer": "skyline",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "tagNameStyleIsolation": "legacy",
      "enableScrollViewAutoSize": true,
      "keyframeStyleIsolation": "legacy",
      "disableABTest": true
    }
  },
  "tabBar": {
    "custom": true,
    "color": "#8E8E93",
    "selectedColor": "#1C1C1E",
    "backgroundColor": "#F6F2EC",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/today/today",
        "text": "今日",
        "iconPath": "images/tabbar/today.png",
        "selectedIconPath": "images/tabbar/today-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "images/tabbar/mine.png",
        "selectedIconPath": "images/tabbar/mine-active.png"
      }
    ]
  },
  "subpackages": [
    {
      "root": "subpackages/meal",
      "name": "meal",
      "pages": [
        "compose/compose",
        "detail/detail"
      ]
    },
    {
      "root": "subpackages/pair",
      "name": "pair",
      "pages": [
        "pair/pair"
      ]
    }
  ],
  "preloadRule": {
    "pages/today/today": {
      "network": "all",
      "packages": ["meal", "pair"]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": ["pair"]
    }
  },
  "miniApp": {
    "useAuthorizePage": true
  },
  "style": "v2",
  "componentFramework": "glass-easel",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
