<view class="screen">
  <view class="glow glow-a"></view>
  <view class="glow glow-b"></view>
  <view class="page-body" style="padding-top: {{statusBarHeight}}px;">
    <text class="brand">moilike</text>
    <text class="sub">记录每一餐，只分享给对方</text>
    <block wx:if="{{sessionPhase === 'form'}}">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
        <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      </button>
      <input class="field" type="nickname" maxlength="32" placeholder="怎么称呼" placeholder-class="ph" value="{{nickName}}" bindinput="onNick" />
      <button class="enter" hover-class="none" bindtap="onSubmit">
        <text class="enter-text">进入</text>
      </button>
    </block>
  </view>
</view>
