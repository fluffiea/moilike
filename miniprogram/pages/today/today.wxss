.date-nav {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.chev {
  width: 72rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chev-mark {
  font-size: 40rpx;
  line-height: 88rpx;
  height: 88rpx;
  color: #c8c2bc;
}

.chev-off {
  opacity: 0.35;
}

.date-label {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.ledger {
  padding: 36rpx 28rpx 32rpx;
}

.wait {
  padding: 80rpx 0;
}

.wait-text {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #8e8e93;
}

.slot {
  margin-bottom: 44rpx;
}

.slot:last-child {
  margin-bottom: 0;
}

.slot-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.slot-name {
  width: 112rpx;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.who {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8e8e93;
}

.vline {
  width: 1rpx;
  height: 28rpx;
  background: rgba(0, 0, 0, 0.08);
}

.who-ta {
  width: 196rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8e8e93;
}

.slot-body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 20rpx;
}

.mine {
  flex: 1;
}

.ta {
  width: 196rpx;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: flex-start;
}

.thumbs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.thumb {
  border-radius: 28rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.thumb-ph {
  background: #f3f0eb;
}

.meal {
  margin-bottom: 20rpx;
}

.meal:last-child {
  margin-bottom: 0;
}

.cap {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  height: 32rpx;
  color: #1c1c1e;
  text-align: center;
}

.empty {
  width: 156rpx;
  height: 156rpx;
  border-radius: 32rpx;
  border: 1rpx dashed rgba(28, 28, 30, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 26rpx;
  color: #8e8e93;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e7a398;
  margin-left: 8rpx;
  margin-top: 72rpx;
}

.entry {
  margin-top: 28rpx;
  padding: 28rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.entry-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(28, 28, 30, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clip {
  width: 28rpx;
  height: 34rpx;
  border: 3rpx solid #1c1c1e;
  border-radius: 6rpx;
  position: relative;
}

.clip-tab {
  position: absolute;
  top: -8rpx;
  left: 6rpx;
  width: 16rpx;
  height: 10rpx;
  border: 3rpx solid #1c1c1e;
  border-radius: 4rpx;
  background: #ffffff;
}

.entry-copy {
  flex: 1;
  margin-left: 20rpx;
  margin-right: 16rpx;
}

.entry-title {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.entry-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8e8e93;
}

.entry-btn {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f3e4de;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-btn-text {
  font-size: 26rpx;
  line-height: 72rpx;
  color: #1c1c1e;
}

.tail {
  height: 28rpx;
}
