/** 信件列表 · moilike-ui · Skyline —— 与浮生/共鸣共用卡片语言 */

.letter-list-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background-color: var(--mo-l0-bg);
}

.letter-list-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.letter-list-feed {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  margin-top: 40rpx;
  padding: 0 40rpx calc(280rpx + env(safe-area-inset-bottom));
}

/* ── 提示行（加载中 / 加载更多 / 已到底）── */

.letter-list-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  box-sizing: border-box;
}

.letter-list-tip-text {
  font-size: 26rpx;
  color: var(--mo-text-secondary);
}

/* ── 空态 ── */

.letter-list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
  box-sizing: border-box;
}

.letter-list-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--mo-text-primary);
  margin-bottom: 12rpx;
}

.letter-list-empty-hint {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
  margin-bottom: 48rpx;
}

.letter-list-empty-btn {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 22rpx 64rpx;
  border-radius: var(--mo-radius-btn);
  background: var(--mo-gradient-brand);
  border: 1rpx solid rgba(74, 102, 112, 0.35);
  box-shadow:
    inset 0 1rpx 0 0 rgba(255, 255, 255, 0.22),
    0 4px 12px rgba(0, 0, 0, 0.02),
    0 12px 28px rgba(74, 102, 112, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.letter-list-empty-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mo-text-inverse);
  letter-spacing: 0.02em;
}

/* ── 月份组头（信匣分格） ── */

.letter-mailbox {
  margin-bottom: 8rpx;
}

.letter-mailbox__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 8rpx 0 20rpx;
}

.letter-mailbox__label {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--mo-text-secondary);
  letter-spacing: 0.04em;
}

.letter-mailbox__line {
  flex: 1;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

/* ── 信件卡 ── */

.letter-card {
  box-sizing: border-box;
  padding: 36rpx 40rpx 40rpx;
  margin-bottom: 32rpx;
  background-color: var(--mo-l1-card);
  border: var(--mo-border-card);
  border-radius: var(--mo-radius-card);
  box-shadow: var(--mo-shadow-card);
}

/* 头行：角色点 + 寄出/收到 + 类型 + 时间 */
.letter-card__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 22rpx;
}

.letter-card__dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.letter-card__dot--sent {
  background-color: var(--mo-brand-rose);
}

.letter-card__dot--received {
  background-color: var(--mo-brand-teal);
}

.letter-card__role {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--mo-text-secondary);
}

.letter-card__type {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--mo-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.letter-card__time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--mo-text-secondary);
}

.letter-card__title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.01em;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.letter-card__preview {
  display: -webkit-box;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--mo-text-secondary);
  overflow: hidden;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.letter-card__preview--loose {
  -webkit-line-clamp: 4;
}

/* 配图：最多 3 张等分，用小圆角与发丝内描边，不加重外框 */
.letter-card__thumbs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.letter-card__thumb {
  width: calc((100% - 24rpx) / 3);
  height: 192rpx;
  margin-right: 12rpx;
  border-radius: 22rpx;
  background-color: var(--mo-l1-accent);
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.035);
}

.letter-card__thumb:nth-child(3n) {
  margin-right: 0;
}

.letter-list-pad {
  height: 40rpx;
}

/* ── 写新信 FAB（与共鸣同款：112rpx 圆角方块 + 品牌渐变 + 白色加号）── */

.letter-list-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 40rpx;
  background: var(--mo-gradient-brand);
  border: 1rpx solid rgba(74, 102, 112, 0.35);
  box-shadow:
    inset 0 1rpx 0 0 rgba(255, 255, 255, 0.22),
    0 4px 12px rgba(0, 0, 0, 0.02),
    0 12px 32px rgba(74, 102, 112, 0.22);
}

.letter-list-fab__plus {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.letter-list-fab__bar {
  position: absolute;
  border-radius: 2rpx;
  background-color: rgba(255, 255, 255, 0.96);
}

.letter-list-fab__bar--h {
  left: 0;
  right: 0;
  top: 50%;
  height: 5rpx;
  transform: translateY(-50%);
}

.letter-list-fab__bar--v {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 5rpx;
  transform: translateX(-50%);
}
