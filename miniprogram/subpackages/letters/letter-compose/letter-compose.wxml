<!--
  写信 · moilike-ui · Skyline
  一张纸：类型在纸上方一行，标题 / 正文 / 配图都写在纸上，底部只留「字数 + 寄出」。
  不用 emoji 做图标（部分机型缺字体显示方框）。
-->
<view class="letter-compose-page">
  <app-nav title="{{navTitle}}" variant="glass" show-back="{{true}}" bind:back="onNavBack" />

  <view class="letter-compose-types">
    <view
      wx:for="{{typeRows}}"
      wx:key="name"
      class="letter-compose-type {{item.selected ? 'letter-compose-type--on' : ''}}"
      data-type="{{item.name}}"
      bind:tap="onToggleType"
      aria-role="button"
      aria-pressed="{{item.selected}}"
    >
      <text class="letter-compose-type-text">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{showCustomTypeInput}}" class="letter-compose-custom">
    <input
      class="letter-compose-custom-input"
      value="{{customTypeValue}}"
      bindinput="onCustomTypeInput"
      bindconfirm="onCustomTypeConfirm"
      placeholder="自定义类型，如：早安信"
      placeholder-class="letter-compose-custom-ph"
      maxlength="{{20}}"
      confirm-type="done"
      adjust-position="{{false}}"
    />
  </view>

  <scroll-view class="letter-compose-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{true}}">
    <view class="letter-compose-paper">
      <text class="letter-compose-salutation">致 {{receiverName}}：</text>

      <input
        class="letter-compose-title"
        value="{{title}}"
        bindinput="onTitleInput"
        placeholder="标题（可选）"
        placeholder-class="letter-compose-title-ph"
        maxlength="{{200}}"
        confirm-type="done"
        adjust-position="{{false}}"
      />

      <textarea
        id="letter-textarea-{{textareaMountKey}}"
        class="letter-compose-content"
        placeholder="写你想说的话…"
        placeholder-class="letter-compose-content-ph"
        maxlength="{{5000}}"
        model:value="{{content}}"
        bindinput="onContentInput"
        auto-height
        show-confirm-bar="{{false}}"
        cursor-spacing="{{24}}"
      />

      <view wx:if="{{images.length > 0}}" class="letter-compose-grid">
        <view wx:for="{{images}}" wx:for-index="imgIdx" wx:key="imgIdx" class="letter-compose-cell">
          <image class="letter-compose-thumb" src="{{imageDisplays[imgIdx]}}" mode="aspectFill" />
          <view class="letter-compose-remove" data-index="{{imgIdx}}" catch:tap="onRemoveImage" aria-role="button" aria-label="删除此图">
            <view class="letter-compose-remove-x">×</view>
          </view>
        </view>
      </view>

      <view class="letter-compose-attach">
        <view class="letter-compose-add" bind:tap="onAddImagesFromAlbum" bind:longpress="onAddImagesFromCamera" aria-role="button" aria-label="添加图片，轻点相册，长按拍照">
          <text class="letter-compose-add-text">{{images.length > 0 ? '再加图片' : '添加图片'}}</text>
        </view>
        <text class="letter-compose-attach-hint">{{images.length}} / 9 · 轻点相册，长按拍照</text>
      </view>
    </view>
  </scroll-view>

  <view class="letter-compose-footer">
    <text class="letter-compose-count">{{content.length}} / 5000</text>
    <view class="letter-compose-send {{canSubmit ? '' : 'letter-compose-send--disabled'}}" bind:tap="onSubmit" aria-role="button" aria-label="寄出这封信">
      <text class="letter-compose-send-text">寄出</text>
    </view>
  </view>
</view>
