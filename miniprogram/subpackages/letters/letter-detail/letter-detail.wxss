/** 读信 · moilike-ui · Skyline —— 整页一张纸，底部「写回信」 */

.letter-detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background-color: var(--mo-l0-bg);
}

.letter-detail-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
}

/* ── 纸 ── */

.letter-read {
  box-sizing: border-box;
  min-height: 100%;
  padding: 44rpx 48rpx 64rpx;
  background-color: var(--mo-l1-card);
}

.letter-read__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 36rpx;
}

.letter-read__type {
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--mo-brand-slate);
  letter-spacing: 0.02em;
}

.letter-read__sep {
  margin: 0 10rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--mo-text-muted);
}

.letter-read__time {
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--mo-text-secondary);
}

.letter-read__title {
  display: block;
  margin-bottom: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.01em;
  color: var(--mo-text-primary);
  word-break: break-word;
}

.letter-read__body {
  display: block;
  font-size: 31rpx;
  line-height: 1.9;
  color: var(--mo-text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ── 配图：1 张整幅、2 张两列、3 张以上三列 ── */

.letter-read__images {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 40rpx -4rpx 0;
}

.letter-read__image-cell {
  width: 33.33%;
  padding: 4rpx;
  box-sizing: border-box;
}

.letter-read__images--dual .letter-read__image-cell {
  width: 50%;
}

.letter-read__images--single {
  margin: 40rpx 0 0;
}

.letter-read__images--single .letter-read__image-cell {
  width: 100%;
  padding: 0;
}

.letter-read__image {
  display: block;
  width: 100%;
  height: 200rpx;
  border-radius: 22rpx;
  background-color: var(--mo-l1-accent);
}

.letter-read__images--single .letter-read__image {
  height: 460rpx;
  border-radius: 28rpx;
}

/* ── 落款 ── */

.letter-read__sign {
  display: block;
  margin-top: 56rpx;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mo-text-secondary);
  letter-spacing: 0.02em;
}

/* ── 底部「写回信」 ── */

.letter-detail-bar {
  flex-shrink: 0;
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: var(--mo-border-card);
  box-sizing: border-box;
}

.letter-detail-reply {
  box-sizing: border-box;
  height: 88rpx;
  border-radius: var(--mo-radius-btn);
  background-color: rgba(102, 143, 128, 0.08);
  border: 1rpx solid rgba(102, 143, 128, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.letter-detail-reply-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mo-brand-slate);
  letter-spacing: 0.04em;
}

/* ── 空态 ── */

.letter-detail-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.letter-detail-empty-text {
  font-size: 28rpx;
  color: var(--mo-text-secondary);
}
