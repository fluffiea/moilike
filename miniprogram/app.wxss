/** moilike V1 — 暖白账本。材质沿用双层阴影与 blur(20px)，色板按高保真改为暖白与灰玫瑰。 */

page {
  --mo-l0-bg: #f6f2ec;
  --mo-l1-card: #ffffff;
  --mo-text-primary: #1c1c1e;
  --mo-text-secondary: #8e8e93;
  --mo-text-muted: #aeaeb2;
  --mo-rose: #c9a59c;
  --mo-blush: #f6e6e1;
  --mo-blush-btn: #f3e4de;
  --mo-dot: #e7a398;
  --mo-shadow-card: 0 4px 12px rgba(0, 0, 0, 0.02), 0 12px 32px rgba(0, 0, 0, 0.04);
  --mo-radius-card: 56rpx;
  --mo-pad-h: 40rpx;
  height: 100vh;
  background-color: var(--mo-l0-bg);
  color: var(--mo-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  border-radius: 0;
  font-weight: normal;
}

button::after {
  border: none;
}

.screen {
  height: 100vh;
  background: var(--mo-l0-bg);
  position: relative;
}

.glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.glow-a {
  width: 480rpx;
  height: 480rpx;
  top: -160rpx;
  right: -160rpx;
  background: rgba(255, 236, 220, 0.9);
}

.glow-b {
  width: 360rpx;
  height: 360rpx;
  left: -180rpx;
  bottom: 40rpx;
  background: rgba(244, 214, 206, 0.35);
}

.page-scroll {
  position: relative;
  height: 100vh;
}

.page-body {
  padding-left: var(--mo-pad-h);
  padding-right: var(--mo-pad-h);
  position: relative;
}

.mo-card {
  background: var(--mo-l1-card);
  border-radius: var(--mo-radius-card);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: var(--mo-shadow-card);
}

.nav {
  position: relative;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--mo-text-primary);
}

.nav-side {
  min-width: 120rpx;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.nav-side-end {
  justify-content: flex-end;
}

.back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5px solid rgba(0, 0, 0, 0.05);
  box-shadow: var(--mo-shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark,
.plain-back {
  font-size: 44rpx;
  line-height: 72rpx;
  height: 72rpx;
  color: var(--mo-text-primary);
  font-weight: 400;
}

.plain-back {
  width: 72rpx;
  text-align: center;
}

.ph {
  color: var(--mo-text-secondary);
}
